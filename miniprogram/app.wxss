/* 全局样式 - 不鸽令 */

/* ========== 全局字体 ========== */
page {
  font-family: 'Avenir Next', 'PingFang SC', 'Hiragino Sans GB', 'Microsoft YaHei', sans-serif;
  background-color: var(--color-bg);
  color: var(--color-secondary);
}

/* ========== 设计令牌 - CSS 变量定义 ========== */
page {
  /* 颜色 */
  --color-primary: #D6542A;
  --color-primary-deep: #9F3616;
  --color-secondary: #181A24;
  --color-ink-soft: #2B3042;
  --color-success: #17886A;
  --color-warning: #BE7A1F;
  --color-danger: #C13B30;
  --color-bg: #F2EFEA;
  --color-bg-elevated: #F8F5F0;
  --color-card: #FFFFFF;
  --color-text-secondary: #61687B;
  --color-border-soft: #E5DED2;
  --color-accent-cool: #1F5C63;
  --color-shadow: rgba(25, 28, 40, 0.10);
  --color-overlay-soft: rgba(214, 84, 42, 0.12);
  --color-overlay-cool: rgba(31, 92, 99, 0.10);
  --surface-hero: linear-gradient(135deg, #FFF7EE 0%, #FFFDF9 56%, #FDE7D7 100%);
  --surface-chip: rgba(255, 255, 255, 0.92);
  --surface-card-soft: linear-gradient(140deg, #FFF8EF 0%, #FFFCF8 100%);
  --surface-card-strong: linear-gradient(180deg, #FFFFFF 0%, #FFFDFC 100%);
  --surface-metric-strong: linear-gradient(135deg, #FFF7ED 0%, #FFFFFF 100%);
  --surface-progress: #FFF8F4;
  --surface-tag: #F3F4F6;
  --surface-progress-forming: #FFF1E8;
  --surface-progress-almost: #FEF3C7;
  --surface-progress-ready: #DCFCE7;
  --text-progress-forming: #C2410C;
  --text-progress-almost: #B45309;
  --text-progress-ready: #15803D;
  --accent-warm-bg-soft: rgba(214, 84, 42, 0.08);
  --accent-warm-bg: rgba(214, 84, 42, 0.12);
  --accent-warm-bg-strong: rgba(214, 84, 42, 0.14);
  --accent-warm-border-soft: rgba(214, 84, 42, 0.22);
  --accent-warm-border-strong: rgba(214, 84, 42, 0.28);
  --accent-cool-bg-soft: rgba(31, 92, 99, 0.08);
  --accent-cool-border-soft: rgba(31, 92, 99, 0.26);
  --text-accent-soft: var(--color-primary-deep);
  --text-accent-soft-strong: var(--color-primary-deep);
  --text-hero-kicker: var(--color-primary-deep);
  --surface-metric: var(--color-bg-elevated);
  --surface-metric-dark: #2A2F40;
  --surface-card-border: rgba(255, 107, 53, 0.08);
  --surface-card-border-strong: rgba(255, 107, 53, 0.10);
  --surface-progress-track: rgba(255, 107, 53, 0.14);
  --surface-progress-track-dark: rgba(240, 123, 78, 0.18);
  --surface-page-muted: #F5F5F7;
  --surface-card-base: #FFFFFF;
  --surface-card-muted: #F8FAFC;
  --surface-card-warm: #FFF7ED;
  --surface-card-warm-soft: #FFF4EE;
  --surface-card-warm-faint: #FFF9F2;
  --surface-card-danger-soft: #FEE2E2;
  --surface-card-neutral-soft: #F3F4F6;
  --surface-card-neutral-strong: #E5E7EB;
  --surface-card-info-soft: #E0F2FE;
  --surface-card-success-soft: #DCFCE7;
  --surface-overlay-strong: rgba(255, 255, 255, 0.9);
  --surface-overlay-medium: rgba(255, 255, 255, 0.84);
  --surface-overlay-light: rgba(255, 255, 255, 0.72);
  --text-title-strong: #111827;
  --text-body-strong: #374151;
  --text-body-soft: #4B5563;
  --text-body-muted: #6B7280;
  --text-body-faint: #9CA3AF;
  --text-warm-strong: #C2410C;
  --text-warm-soft: #9F3616;
  --text-warm-muted: #7C5A4A;
  --text-brown-strong: #3F2C22;
  --text-status-danger: #EF4444;
  --text-status-success: #10B981;
  --text-status-warning: #F59E0B;
  --text-status-info: #0369A1;
  --text-status-neutral: #4B5563;
  --border-soft-2: #F3F4F6;
  --border-soft-3: #F1F5F9;
  --border-warm-soft: #F5DDC5;
  --border-warm-faint: #F0E8DB;
  --border-warm-ink: rgba(159, 54, 22, 0.1);
  --shadow-soft: 0 12rpx 32rpx rgba(15, 23, 42, 0.06);
  --shadow-warm: 0 8rpx 24rpx rgba(255, 107, 53, 0.08);
  --shadow-pop: 0 8rpx 20rpx rgba(15, 23, 42, 0.08);

  /* 字号 */
  --font-size-xl: 44rpx;
  --font-size-lg: 34rpx;
  --font-size-md: 28rpx;
  --font-size-sm: 24rpx;
  --font-size-xs: 22rpx;
  --font-size-price: 48rpx;

  /* 间距 */
  --spacing-page: 28rpx;
  --spacing-card-inner: 26rpx;
  --spacing-card-gap: 20rpx;

  /* 圆角 */
  --radius-card: 24rpx;
  --radius-btn: 20rpx;
  --radius-tag: 999rpx;
  --radius-input: 18rpx;

  /* 动效 */
  --motion-fast: 160ms;
  --motion-normal: 280ms;
  --motion-slow: 420ms;
  --ease-standard: cubic-bezier(0.22, 0.61, 0.36, 1);
}

@keyframes cardRiseIn {
  from {
    transform: translateY(18rpx);
    opacity: 0;
  }
  to {
    transform: translateY(0);
    opacity: 1;
  }
}

@keyframes fadeInSoft {
  from {
    opacity: 0;
  }
  to {
    opacity: 1;
  }
}

/* ========== 基础组件样式 ========== */

/* 页面容器 */
.page {
  min-height: 100vh;
  padding: var(--spacing-page);
  box-sizing: border-box;
  background: linear-gradient(180deg, var(--color-bg) 0%, var(--color-bg-elevated) 100%);
}

/* 卡片容器 */
.card {
  background-color: var(--color-card);
  border-radius: var(--radius-card);
  padding: var(--spacing-card-inner);
  margin-bottom: var(--spacing-card-gap);
  border: 1rpx solid var(--color-border-soft);
  box-shadow: 0 14rpx 34rpx rgba(25, 28, 40, 0.06);
  animation: cardRiseIn var(--motion-slow) var(--ease-standard);
}

/* 主按钮 */
.btn-primary {
  background: linear-gradient(130deg, var(--color-primary) 0%, var(--color-primary-deep) 100%);
  color: #FFFFFF;
  border-radius: var(--radius-btn);
  padding: 24rpx 48rpx;
  font-size: var(--font-size-md);
  font-weight: 700;
  letter-spacing: 1rpx;
  border: none;
  text-align: center;
  box-shadow: 0 12rpx 24rpx rgba(159, 54, 22, 0.25);
  transition: transform var(--motion-fast) var(--ease-standard), opacity var(--motion-fast) var(--ease-standard);
}

.btn-primary:active {
  opacity: 0.9;
  transform: translateY(1rpx);
}

/* 次按钮 */
.btn-secondary {
  background-color: transparent;
  color: var(--color-primary-deep);
  border: 2rpx solid rgba(159, 54, 22, 0.35);
  border-radius: var(--radius-btn);
  padding: 24rpx 48rpx;
  font-size: var(--font-size-md);
  font-weight: 600;
  text-align: center;
  transition: background-color var(--motion-fast) var(--ease-standard), border-color var(--motion-fast) var(--ease-standard);
}

.btn-secondary:active {
  background-color: rgba(214, 84, 42, 0.08);
}

/* 状态标签 */
.tag {
  display: inline-block;
  padding: 4rpx 12rpx;
  border-radius: var(--radius-tag);
  font-size: var(--font-size-xs);
  font-weight: 500;
}

@media (prefers-color-scheme: dark) {
  page {
    --color-primary: #F07B4E;
    --color-primary-deep: #C65B33;
    --color-secondary: #F6F2E9;
    --color-ink-soft: #D9D3C6;
    --color-success: #46B494;
    --color-warning: #E0AA54;
    --color-danger: #E07268;
    --color-bg: #13151D;
    --color-bg-elevated: #1A1D28;
    --color-card: #202432;
    --color-text-secondary: #B1B7CA;
    --color-border-soft: #2E3448;
    --color-accent-cool: #76BAC1;
    --color-shadow: rgba(0, 0, 0, 0.42);
    --color-overlay-soft: rgba(240, 123, 78, 0.16);
    --color-overlay-cool: rgba(118, 186, 193, 0.14);
    --surface-hero: linear-gradient(145deg, #272034 0%, #1E2433 60%, #273142 100%);
    --surface-chip: rgba(255, 255, 255, 0.06);
    --surface-card-soft: linear-gradient(145deg, #2A2432 0%, #202432 100%);
    --surface-card-strong: linear-gradient(180deg, #252B3A 0%, #202432 100%);
    --surface-metric-strong: linear-gradient(135deg, #312A23 0%, #252B3A 100%);
    --surface-progress: linear-gradient(180deg, #2B2630 0%, #252B3A 100%);
    --surface-tag: #2C3244;
    --surface-progress-forming: rgba(240, 123, 78, 0.16);
    --surface-progress-almost: rgba(224, 170, 84, 0.18);
    --surface-progress-ready: rgba(70, 180, 148, 0.18);
    --text-progress-forming: #FFBE9E;
    --text-progress-almost: #F0CC82;
    --text-progress-ready: #90DEC3;
    --accent-warm-bg-soft: rgba(240, 123, 78, 0.12);
    --accent-warm-bg: rgba(240, 123, 78, 0.16);
    --accent-warm-bg-strong: rgba(240, 123, 78, 0.18);
    --accent-warm-border-soft: rgba(240, 123, 78, 0.24);
    --accent-warm-border-strong: rgba(240, 123, 78, 0.32);
    --accent-cool-bg-soft: rgba(118, 186, 193, 0.12);
    --accent-cool-border-soft: rgba(118, 186, 193, 0.22);
    --text-accent-soft: var(--color-primary);
    --text-accent-soft-strong: #FFB08D;
    --text-hero-kicker: #FFD8C5;
    --surface-metric: #2A2F40;
    --surface-metric-dark: #2A2F40;
    --surface-card-border: rgba(240, 123, 78, 0.16);
    --surface-card-border-strong: rgba(240, 123, 78, 0.16);
    --surface-progress-track: rgba(240, 123, 78, 0.18);
    --surface-progress-track-dark: rgba(240, 123, 78, 0.18);
    --surface-page-muted: #161925;
    --surface-card-base: #202432;
    --surface-card-muted: #252B3A;
    --surface-card-warm: #2B2630;
    --surface-card-warm-soft: #312822;
    --surface-card-warm-faint: #2E2924;
    --surface-card-danger-soft: #362327;
    --surface-card-neutral-soft: #2C3244;
    --surface-card-neutral-strong: #3A4154;
    --surface-card-info-soft: #24313D;
    --surface-card-success-soft: #20352F;
    --surface-overlay-strong: rgba(32, 36, 50, 0.92);
    --surface-overlay-medium: rgba(37, 43, 58, 0.88);
    --surface-overlay-light: rgba(44, 50, 68, 0.78);
    --text-title-strong: #F6F2E9;
    --text-body-strong: #D6DCE9;
    --text-body-soft: #C5CAD8;
    --text-body-muted: #B1B7CA;
    --text-body-faint: #9098AE;
    --text-warm-strong: #FFBE9E;
    --text-warm-soft: #FFD0B7;
    --text-warm-muted: #D9B6A2;
    --text-brown-strong: #E8D7CB;
    --text-status-danger: #F28B82;
    --text-status-success: #90DEC3;
    --text-status-warning: #F0CC82;
    --text-status-info: #8CC8E8;
    --text-status-neutral: #C5CAD8;
    --border-soft-2: #31384B;
    --border-soft-3: #2A3042;
    --border-warm-soft: #5A4336;
    --border-warm-faint: #4A3A31;
    --border-warm-ink: rgba(255, 190, 158, 0.16);
    --shadow-soft: 0 12rpx 32rpx rgba(0, 0, 0, 0.28);
    --shadow-warm: 0 8rpx 24rpx rgba(0, 0, 0, 0.24);
    --shadow-pop: 0 8rpx 20rpx rgba(0, 0, 0, 0.24);
  }

  .card {
    box-shadow: 0 14rpx 34rpx rgba(0, 0, 0, 0.34);
  }

  .btn-primary {
    box-shadow: 0 12rpx 24rpx rgba(0, 0, 0, 0.28);
  }
}

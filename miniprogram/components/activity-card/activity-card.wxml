<view class="activity-card" bindtap="onCardTap" wx:if="{{activity}}">
  <view class="card-chip-row" wx:if="{{card && card.chips && card.chips.length}}">
    <text class="template-badge" wx:for="{{card.chips}}" wx:key="index">{{item}}</text>
  </view>

  <view class="card-main" wx:if="{{card}}">
    <text class="card-title">{{card.title}}</text>
    <text class="card-hook">{{card.hookText}}</text>
    <text class="card-detail">{{card.detailLine}}</text>
    <text class="card-footer-text">{{card.footerText}}</text>
  </view>
</view>

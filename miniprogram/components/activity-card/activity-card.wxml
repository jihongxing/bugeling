<!-- components/activity-card/activity-card.wxml - 活动卡片 -->
<view class="activity-card" bindtap="onCardTap" wx:if="{{activity}}">
  <view class="card-header" wx:if="{{card}}">
    <view class="header-main">
      <text class="template-badge">{{card.templateLabel}}</text>
      <text class="card-title">{{card.title}}</text>
    </view>
    <view class="progress-chip progress-{{card.progressState}}">
      <text class="progress-chip-text">{{card.progressText}}</text>
    </view>
  </view>

  <view class="metrics-grid" wx:if="{{card}}">
    <view class="metric-card metric-strong">
      <text class="metric-label">大概花费</text>
      <text class="metric-value">{{card.budgetText}}</text>
    </view>
    <view class="metric-card">
      <text class="metric-label">加入要付</text>
      <text class="metric-value">{{card.feeText}}</text>
    </view>
    <view class="metric-card">
      <text class="metric-label">什么时候见</text>
      <text class="metric-value">{{card.meetTimeText}}</text>
    </view>
    <view class="metric-card">
      <text class="metric-label">离你多远</text>
      <text class="metric-value">{{card.distanceText}}</text>
    </view>
  </view>

  <view class="progress-section" wx:if="{{card}}">
    <view class="progress-head">
      <text class="progress-title">现在这局到哪了</text>
      <text class="progress-detail">{{card.progressDetail}}</text>
    </view>
    <view class="progress-track">
      <view class="progress-fill progress-{{card.progressState}}" style="width: {{card.progressPercent}}%;"></view>
    </view>
    <text class="progress-hint">{{card.progressHint}}</text>
  </view>

  <view class="safety-tags" wx:if="{{card && card.safetyTags && card.safetyTags.length}}">
    <text class="safety-tag" wx:for="{{card.safetyTags}}" wx:key="index">{{item}}</text>
  </view>

  <view class="card-footer" wx:if="{{card}}">
    <text class="location-text">{{card.locationText}}</text>
    <text class="credit-text">最近看起来 {{card.creditText}}</text>
  </view>
</view>

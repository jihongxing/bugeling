.activity-card {
  background:
    radial-gradient(circle at top right, var(--accent-warm-bg) 0%, transparent 34%),
    var(--surface-card-strong);
  border-radius: 28rpx;
  padding: 28rpx;
  box-shadow: 0 16rpx 40rpx rgba(26, 26, 46, 0.06);
  border: 1rpx solid var(--surface-card-border);
}

.card-chip-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 18rpx;
}

.template-badge {
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  background: var(--accent-warm-bg);
  font-size: var(--font-size-xs);
  color: var(--color-primary-deep);
  font-weight: 600;
}

.card-main {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.card-title {
  font-size: 36rpx;
  line-height: 1.4;
  font-weight: 700;
  color: var(--color-secondary);
  word-break: break-word;
}

.card-hook {
  font-size: 30rpx;
  line-height: 1.5;
  font-weight: 600;
  color: var(--color-secondary);
}

.card-detail,
.card-footer-text {
  font-size: var(--font-size-sm);
  line-height: 1.6;
  color: var(--color-text-secondary);
}

.card-footer-text {
  padding-top: 6rpx;
}

@media (prefers-color-scheme: dark) {
  .activity-card {
    background:
      radial-gradient(circle at top right, var(--accent-warm-bg-strong) 0%, transparent 36%),
      var(--surface-card-strong);
    box-shadow: 0 16rpx 40rpx rgba(0, 0, 0, 0.28);
    border: 1rpx solid var(--surface-card-border);
  }

  .template-badge {
    background: var(--accent-warm-bg);
  }
}

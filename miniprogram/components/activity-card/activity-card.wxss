/* components/activity-card/activity-card.wxss */
.activity-card {
  background:
    radial-gradient(circle at top right, rgba(255, 107, 53, 0.10), transparent 34%),
    linear-gradient(180deg, #FFFFFF 0%, #FFFDFC 100%);
  border-radius: 28rpx;
  padding: 28rpx;
  box-shadow: 0 16rpx 40rpx rgba(26, 26, 46, 0.06);
  border: 1rpx solid rgba(255, 107, 53, 0.08);
}

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 20rpx;
  margin-bottom: 24rpx;
}

.header-main {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.template-badge {
  align-self: flex-start;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  background: rgba(255, 107, 53, 0.12);
  font-size: var(--font-size-xs);
  color: #C2410C;
  font-weight: 600;
}

.card-title {
  font-size: 34rpx;
  font-weight: 700;
  line-height: 1.45;
  color: var(--color-secondary);
  word-break: break-word;
}

.progress-chip {
  flex-shrink: 0;
  padding: 12rpx 16rpx;
  border-radius: 20rpx;
}

.progress-chip-text {
  font-size: var(--font-size-xs);
  font-weight: 700;
}

.progress-forming {
  background: #FFF1E8;
  color: #C2410C;
}

.progress-almost {
  background: #FEF3C7;
  color: #B45309;
}

.progress-ready,
.progress-full {
  background: #DCFCE7;
  color: #15803D;
}

.metrics-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.metric-card {
  width: calc(50% - 8rpx);
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  box-sizing: border-box;
  padding: 20rpx;
  border-radius: 20rpx;
  background: #F9FAFB;
}

.metric-strong {
  background: linear-gradient(135deg, #FFF7ED 0%, #FFFFFF 100%);
  border: 1rpx solid rgba(255, 107, 53, 0.10);
}

.metric-label {
  font-size: var(--font-size-sm);
  color: var(--color-text-secondary);
}

.metric-value {
  font-size: var(--font-size-sm);
  color: var(--color-secondary);
  line-height: 1.5;
  font-weight: 600;
}

.progress-section {
  padding: 22rpx 24rpx;
  border-radius: 22rpx;
  background: #FFF8F4;
  margin-bottom: 20rpx;
}

.progress-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 14rpx;
}

.progress-title {
  font-size: var(--font-size-sm);
  color: var(--color-secondary);
  font-weight: 600;
}

.progress-detail {
  font-size: var(--font-size-xs);
  color: var(--color-text-secondary);
}

.progress-track {
  width: 100%;
  height: 14rpx;
  border-radius: 999rpx;
  background: rgba(255, 107, 53, 0.14);
  overflow: hidden;
  margin-bottom: 14rpx;
}

.progress-fill {
  height: 100%;
  border-radius: 999rpx;
}

.progress-hint {
  font-size: var(--font-size-xs);
  color: var(--color-text-secondary);
}

.safety-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 20rpx;
}

.safety-tag {
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  background: #F3F4F6;
  font-size: var(--font-size-xs);
  color: #4B5563;
}

.card-footer {
  border-top: 1rpx solid rgba(243, 244, 246, 0.92);
  padding-top: 18rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 16rpx;
}

.location-text,
.credit-text {
  font-size: var(--font-size-xs);
  color: var(--color-text-secondary);
  line-height: 1.5;
}

.location-text {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

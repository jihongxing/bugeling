/* components/activity-card/activity-card.wxss */
.activity-card {
  background:
    radial-gradient(circle at top right, var(--accent-warm-bg) 0%, transparent 34%),
    var(--surface-card-strong);
  border-radius: 28rpx;
  padding: 28rpx;
  box-shadow: 0 16rpx 40rpx rgba(26, 26, 46, 0.06);
  border: 1rpx solid var(--surface-card-border);
}

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 20rpx;
  margin-bottom: 24rpx;
}

.header-main {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.template-badge {
  align-self: flex-start;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  background: var(--accent-warm-bg);
  font-size: var(--font-size-xs);
  color: var(--color-primary-deep);
  font-weight: 600;
}

.card-title {
  font-size: 34rpx;
  font-weight: 700;
  line-height: 1.45;
  color: var(--color-secondary);
  word-break: break-word;
}

.progress-chip {
  flex-shrink: 0;
  padding: 12rpx 16rpx;
  border-radius: 20rpx;
}

.progress-chip-text {
  font-size: var(--font-size-xs);
  font-weight: 700;
}

.progress-forming {
  background: var(--surface-progress-forming);
  color: var(--text-progress-forming);
}

.progress-almost {
  background: var(--surface-progress-almost);
  color: var(--text-progress-almost);
}

.progress-ready,
.progress-full {
  background: var(--surface-progress-ready);
  color: var(--text-progress-ready);
}

.metrics-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.metric-card {
  width: calc(50% - 8rpx);
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  box-sizing: border-box;
  padding: 20rpx;
  border-radius: 20rpx;
  background: var(--surface-metric);
}

.metric-strong {
  background: var(--surface-metric-strong);
  border: 1rpx solid var(--surface-card-border-strong);
}

.metric-label {
  font-size: var(--font-size-sm);
  color: var(--color-text-secondary);
}

.metric-value {
  font-size: var(--font-size-sm);
  color: var(--color-secondary);
  line-height: 1.5;
  font-weight: 600;
}

.progress-section {
  padding: 22rpx 24rpx;
  border-radius: 22rpx;
  background: var(--surface-progress);
  margin-bottom: 20rpx;
}

.progress-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 14rpx;
}

.progress-title {
  font-size: var(--font-size-sm);
  color: var(--color-secondary);
  font-weight: 600;
}

.progress-detail {
  font-size: var(--font-size-xs);
  color: var(--color-text-secondary);
}

.progress-track {
  width: 100%;
  height: 14rpx;
  border-radius: 999rpx;
  background: var(--surface-progress-track);
  overflow: hidden;
  margin-bottom: 14rpx;
}

.progress-fill {
  height: 100%;
  border-radius: 999rpx;
}

.progress-hint {
  font-size: var(--font-size-xs);
  color: var(--color-text-secondary);
}

.safety-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 20rpx;
}

.safety-tag {
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  background: var(--surface-tag);
  font-size: var(--font-size-xs);
  color: var(--color-ink-soft);
}

.card-footer {
  border-top: 1rpx solid var(--color-border-soft);
  padding-top: 18rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 16rpx;
}

.location-text,
.credit-text {
  font-size: var(--font-size-xs);
  color: var(--color-text-secondary);
  line-height: 1.5;
}

.location-text {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

@media (prefers-color-scheme: dark) {
  .activity-card {
    background:
      radial-gradient(circle at top right, var(--accent-warm-bg-strong) 0%, transparent 36%),
      var(--surface-card-strong);
    box-shadow: 0 16rpx 40rpx rgba(0, 0, 0, 0.28);
    border: 1rpx solid var(--surface-card-border);
  }

  .template-badge {
    background: var(--accent-warm-bg);
  }

  .metric-card {
    background: var(--surface-metric-dark);
  }

  .metric-strong {
    border: 1rpx solid var(--surface-card-border-strong);
  }

  .progress-track {
    background: var(--surface-progress-track-dark);
  }

  .safety-tag {
    color: #C5CAD8;
  }

  .card-footer {
    border-top: 1rpx solid rgba(46, 52, 72, 0.92);
  }
}

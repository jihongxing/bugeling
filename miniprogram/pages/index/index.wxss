/* pages/index/index.wxss */
.index-page {
  padding-top: 20rpx;
  padding-bottom: 40rpx;
}

.hero-card {
  position: relative;
  overflow: hidden;
  background: linear-gradient(135deg, #FFF7EE 0%, #FFFDF9 56%, #FDE7D7 100%);
  border: 1rpx solid var(--color-overlay-soft);
  border-radius: 34rpx;
  padding: 34rpx;
  margin-bottom: 22rpx;
  box-shadow: 0 20rpx 48rpx var(--color-shadow);
  animation: cardRiseIn var(--motion-slow) var(--ease-standard);
}

.hero-glow {
  position: absolute;
  border-radius: 50%;
  pointer-events: none;
}

.hero-glow-left {
  width: 280rpx;
  height: 280rpx;
  top: -110rpx;
  left: -80rpx;
  background: radial-gradient(circle, var(--color-overlay-soft) 0%, rgba(214, 84, 42, 0) 72%);
}

.hero-glow-right {
  width: 320rpx;
  height: 320rpx;
  right: -120rpx;
  bottom: -150rpx;
  background: radial-gradient(circle, var(--color-overlay-cool) 0%, rgba(31, 92, 99, 0) 75%);
}

.hero-copy {
  position: relative;
  z-index: 2;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  margin-bottom: 28rpx;
  animation: fadeInSoft var(--motion-slow) var(--ease-standard);
}

.hero-kicker {
  align-self: flex-start;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  background: rgba(214, 84, 42, 0.12);
  font-size: 21rpx;
  color: var(--color-primary-deep);
  letter-spacing: 2rpx;
  font-weight: 700;
}

.hero-title {
  font-size: 50rpx;
  line-height: 1.22;
  color: var(--color-secondary);
  font-weight: 700;
  letter-spacing: 1rpx;
}

.hero-subtitle {
  font-size: var(--font-size-sm);
  line-height: 1.6;
  color: rgba(24, 26, 36, 0.74);
}

.hero-toolbar {
  position: relative;
  z-index: 2;
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 24rpx;
  animation: fadeInSoft var(--motion-normal) var(--ease-standard);
}

.location-chip {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 14rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.92);
  border: 1rpx solid var(--color-overlay-soft);
}

.location-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: var(--color-primary);
  flex-shrink: 0;
}

.location-name {
  min-width: 0;
  font-size: var(--font-size-sm);
  color: var(--color-secondary);
  font-weight: 500;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.refresh-btn {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 14rpx 20rpx;
  border-radius: 999rpx;
  background: var(--color-overlay-soft);
  border: 1rpx solid rgba(214, 84, 42, 0.22);
  transition: transform var(--motion-fast) var(--ease-standard), background-color var(--motion-fast) var(--ease-standard);
}

.refresh-btn:active {
  transform: translateY(1rpx);
}

.refresh-icon,
.refresh-text {
  font-size: var(--font-size-sm);
  color: var(--color-primary);
  font-weight: 600;
}

.template-section,
.feed-section {
  background: var(--color-card);
  border-radius: 26rpx;
  padding: 30rpx 28rpx;
  border: 1rpx solid var(--color-border-soft);
  box-shadow: 0 12rpx 28rpx rgba(25, 28, 40, 0.06);
  margin-bottom: 24rpx;
  animation: cardRiseIn var(--motion-slow) var(--ease-standard);
}

.section-head {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 36rpx;
  color: var(--color-secondary);
  font-weight: 700;
}

.section-title.small {
  font-size: 30rpx;
}

.section-mark {
  display: inline-block;
  font-size: 20rpx;
  letter-spacing: 1.5rpx;
  color: var(--color-accent-cool);
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  border: 1rpx solid rgba(31, 92, 99, 0.26);
  background: rgba(31, 92, 99, 0.08);
}

.section-desc {
  font-size: var(--font-size-sm);
  color: var(--color-text-secondary);
}

.template-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}

.template-card {
  width: 48.8%;
  background: var(--color-bg-elevated);
  border-radius: 22rpx;
  padding: 20rpx;
  border: 1rpx solid #EFE7DB;
  box-sizing: border-box;
  margin-bottom: 14rpx;
  transition: transform var(--motion-fast) var(--ease-standard), border-color var(--motion-fast) var(--ease-standard), box-shadow var(--motion-fast) var(--ease-standard);
}

.template-card:active {
  border-color: #F4B58D;
  transform: translateY(1rpx);
}

.template-card:nth-child(1),
.template-card:nth-child(2) {
  animation: fadeInSoft 280ms var(--ease-standard);
}

.template-card:nth-child(3),
.template-card:nth-child(4) {
  animation: fadeInSoft 360ms var(--ease-standard);
}

.template-card:nth-child(5),
.template-card:nth-child(6) {
  animation: fadeInSoft 440ms var(--ease-standard);
}

.template-card.secondary {
  background: var(--color-bg-elevated);
}

.template-label {
  display: block;
  font-size: 28rpx;
  color: var(--color-secondary);
  font-weight: 700;
  margin-bottom: 8rpx;
}

.template-desc {
  display: block;
  font-size: 24rpx;
  line-height: 1.45;
  color: var(--color-text-secondary);
  min-height: 70rpx;
}

.template-action {
  display: inline-flex;
  margin-top: 14rpx;
  padding: 8rpx 14rpx;
  font-size: 21rpx;
  color: var(--color-primary-deep);
  background: rgba(214, 84, 42, 0.08);
  border-radius: 999rpx;
}

.more-templates-toggle {
  margin-top: 16rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-radius: 18rpx;
  background: rgba(214, 84, 42, 0.08);
  padding: 18rpx;
}

.more-templates-text,
.more-templates-arrow {
  font-size: 24rpx;
  color: var(--color-primary-deep);
  font-weight: 600;
}

.template-grid.more {
  margin-top: 12rpx;
  margin-bottom: -14rpx;
}

.examples-wrap {
  margin-top: 18rpx;
}

.example-list {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.example-card {
  border-radius: 22rpx;
  background: linear-gradient(140deg, #FFF8EF 0%, #FFFCF8 100%);
  padding: 20rpx;
  border: 1rpx solid rgba(214, 84, 42, 0.22);
  transition: transform var(--motion-fast) var(--ease-standard), border-color var(--motion-fast) var(--ease-standard);
}

.example-card:active {
  transform: translateY(1rpx);
}

.example-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.example-badge {
  font-size: 22rpx;
  color: #9F3616;
  background: rgba(214, 84, 42, 0.14);
  border-radius: 999rpx;
  padding: 6rpx 14rpx;
}

.example-cta {
  font-size: 24rpx;
  color: #B9441D;
  font-weight: 600;
}

.example-title {
  display: block;
  font-size: 30rpx;
  color: var(--color-secondary);
  font-weight: 700;
  margin-bottom: 8rpx;
}

.example-summary {
  display: block;
  font-size: 24rpx;
  line-height: 1.55;
  color: var(--color-text-secondary);
}

.feed-head {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 20rpx;
}

.feed-head-copy {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.feed-title {
  font-size: 36rpx;
  color: var(--color-secondary);
  font-weight: 700;
}

.feed-desc {
  font-size: var(--font-size-sm);
  color: var(--color-text-secondary);
}

.feed-count {
  font-size: var(--font-size-xs);
  color: var(--color-primary-deep);
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  background: rgba(214, 84, 42, 0.12);
}

.activity-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.feed-empty-card {
  border-radius: 24rpx;
  background: var(--color-bg-elevated);
  border: 1rpx solid #EEE4D7;
  padding: 28rpx 24rpx;
}

.feed-empty-title {
  display: block;
  font-size: 30rpx;
  font-weight: 700;
  color: var(--color-secondary);
  margin-bottom: 10rpx;
}

.feed-empty-desc {
  display: block;
  font-size: 24rpx;
  line-height: 1.6;
  color: var(--color-text-secondary);
}

.loading-state,
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  padding: 140rpx 36rpx;
  text-align: center;
}

.loading-title,
.empty-title {
  font-size: 34rpx;
  color: var(--color-secondary);
  font-weight: 700;
}

.loading-desc,
.empty-text {
  font-size: var(--font-size-sm);
  line-height: 1.7;
  color: var(--color-text-secondary);
}

.loading-tip,
.no-more-tip {
  text-align: center;
  padding: 12rpx 0 8rpx;
  font-size: var(--font-size-sm);
  color: var(--color-text-secondary);
}

@media (prefers-color-scheme: dark) {
  .hero-card {
    background: linear-gradient(145deg, #272034 0%, #1E2433 60%, #273142 100%);
  }

  .location-chip {
    background: rgba(255, 255, 255, 0.06);
  }

  .template-card,
  .example-card,
  .feed-empty-card {
    border-color: var(--color-border-soft);
  }
}

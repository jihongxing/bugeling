/* pages/index/index.wxss */
.index-page {
  padding-top: 24rpx;
  padding-bottom: 40rpx;
}

.hero-card {
  background: linear-gradient(135deg, #FFF3EB 0%, #FFFFFF 52%, #FFE4D6 100%);
  border-radius: 32rpx;
  padding: 32rpx;
  margin-bottom: 28rpx;
  box-shadow: 0 18rpx 48rpx rgba(255, 107, 53, 0.10);
}

.hero-copy {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  margin-bottom: 28rpx;
}

.hero-kicker {
  font-size: var(--font-size-xs);
  color: #B45309;
  letter-spacing: 2rpx;
  font-weight: 600;
}

.hero-title {
  font-size: 44rpx;
  line-height: 1.3;
  color: var(--color-secondary);
  font-weight: 700;
}

.hero-subtitle {
  font-size: var(--font-size-sm);
  line-height: 1.6;
  color: rgba(26, 26, 46, 0.72);
}

.hero-toolbar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 24rpx;
}

.location-chip {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 14rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.78);
}

.location-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: var(--color-primary);
  flex-shrink: 0;
}

.location-name {
  min-width: 0;
  font-size: var(--font-size-sm);
  color: var(--color-secondary);
  font-weight: 500;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.refresh-btn {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 14rpx 20rpx;
  border-radius: 999rpx;
  background: rgba(255, 107, 53, 0.12);
}

.refresh-icon,
.refresh-text {
  font-size: var(--font-size-sm);
  color: var(--color-primary);
  font-weight: 600;
}

.template-section,
.feed-section {
  background: #FFFFFF;
  border-radius: 28rpx;
  padding: 28rpx;
  box-shadow: 0 12rpx 32rpx rgba(15, 23, 42, 0.05);
  margin-bottom: 24rpx;
}

.section-head {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 34rpx;
  color: var(--color-secondary);
  font-weight: 700;
}

.section-title.small {
  font-size: 30rpx;
}

.section-desc {
  font-size: var(--font-size-sm);
  color: var(--color-text-secondary);
}

.template-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}

.template-card {
  width: 48.8%;
  background: #F8FAFC;
  border-radius: 22rpx;
  padding: 18rpx 20rpx;
  border: 2rpx solid transparent;
  box-sizing: border-box;
  margin-bottom: 14rpx;
}

.template-card:active {
  border-color: #FDBA74;
}

.template-card.secondary {
  background: #F9FAFB;
}

.template-label {
  display: block;
  font-size: 28rpx;
  color: #111827;
  font-weight: 700;
  margin-bottom: 8rpx;
}

.template-desc {
  display: block;
  font-size: 24rpx;
  line-height: 1.45;
  color: #6B7280;
}

.more-templates-toggle {
  margin-top: 16rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-radius: 18rpx;
  background: #FFF7ED;
  padding: 16rpx 18rpx;
}

.more-templates-text,
.more-templates-arrow {
  font-size: 24rpx;
  color: #C2410C;
  font-weight: 600;
}

.template-grid.more {
  margin-top: 12rpx;
  margin-bottom: -14rpx;
}

.examples-wrap {
  margin-top: 18rpx;
}

.example-list {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.example-card {
  border-radius: 22rpx;
  background: linear-gradient(140deg, #FFF8F1 0%, #FFFFFF 100%);
  padding: 20rpx;
  border: 1rpx solid rgba(251, 146, 60, 0.25);
}

.example-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.example-badge {
  font-size: 22rpx;
  color: #C2410C;
  background: rgba(251, 146, 60, 0.16);
  border-radius: 999rpx;
  padding: 6rpx 14rpx;
}

.example-cta {
  font-size: 24rpx;
  color: #EA580C;
  font-weight: 600;
}

.example-title {
  display: block;
  font-size: 30rpx;
  color: #111827;
  font-weight: 700;
  margin-bottom: 8rpx;
}

.example-summary {
  display: block;
  font-size: 24rpx;
  line-height: 1.55;
  color: #6B7280;
}

.feed-head {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 20rpx;
}

.feed-head-copy {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.feed-title {
  font-size: 34rpx;
  color: var(--color-secondary);
  font-weight: 700;
}

.feed-desc {
  font-size: var(--font-size-sm);
  color: var(--color-text-secondary);
}

.feed-count {
  font-size: var(--font-size-xs);
  color: var(--color-primary);
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  background: rgba(255, 107, 53, 0.10);
}

.activity-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.feed-empty-card {
  border-radius: 24rpx;
  background: #F8FAFC;
  padding: 28rpx 24rpx;
}

.feed-empty-title {
  display: block;
  font-size: 30rpx;
  font-weight: 700;
  color: #111827;
  margin-bottom: 10rpx;
}

.feed-empty-desc {
  display: block;
  font-size: 24rpx;
  line-height: 1.6;
  color: #6B7280;
}

.loading-state,
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  padding: 140rpx 36rpx;
  text-align: center;
}

.loading-title,
.empty-title {
  font-size: 34rpx;
  color: var(--color-secondary);
  font-weight: 700;
}

.loading-desc,
.empty-text {
  font-size: var(--font-size-sm);
  line-height: 1.7;
  color: var(--color-text-secondary);
}

.loading-tip,
.no-more-tip {
  text-align: center;
  padding: 12rpx 0 8rpx;
  font-size: var(--font-size-sm);
  color: var(--color-text-secondary);
}

/* pages/index/index.wxss */
.index-page {
  padding-top: 24rpx;
}

.hero-card {
  background: linear-gradient(135deg, #FFF3EB 0%, #FFFFFF 52%, #FFE4D6 100%);
  border-radius: 32rpx;
  padding: 32rpx;
  margin-bottom: 28rpx;
  box-shadow: 0 18rpx 48rpx rgba(255, 107, 53, 0.10);
}

.hero-copy {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  margin-bottom: 28rpx;
}

.hero-kicker {
  font-size: var(--font-size-xs);
  color: #B45309;
  letter-spacing: 2rpx;
  font-weight: 600;
}

.hero-title {
  font-size: 44rpx;
  line-height: 1.3;
  color: var(--color-secondary);
  font-weight: 700;
}

.hero-subtitle {
  font-size: var(--font-size-sm);
  line-height: 1.6;
  color: rgba(26, 26, 46, 0.72);
}

.hero-toolbar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 24rpx;
}

.location-chip {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 14rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.78);
}

.location-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: var(--color-primary);
  flex-shrink: 0;
}

.location-name {
  min-width: 0;
  font-size: var(--font-size-sm);
  color: var(--color-secondary);
  font-weight: 500;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.refresh-btn {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 14rpx 20rpx;
  border-radius: 999rpx;
  background: rgba(255, 107, 53, 0.12);
}

.refresh-icon,
.refresh-text {
  font-size: var(--font-size-sm);
  color: var(--color-primary);
  font-weight: 600;
}

.hero-stats {
  display: flex;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.stat-card {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  padding: 20rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.84);
}

.stat-value {
  font-size: 40rpx;
  line-height: 1;
  color: var(--color-secondary);
  font-weight: 700;
}

.stat-label {
  font-size: var(--font-size-xs);
  color: var(--color-text-secondary);
}

.hero-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.hero-tag {
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.88);
  font-size: var(--font-size-xs);
  color: #9A3412;
}

.feed-section {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.feed-head {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 20rpx;
}

.feed-head-copy {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.feed-title {
  font-size: 34rpx;
  color: var(--color-secondary);
  font-weight: 700;
}

.feed-desc {
  font-size: var(--font-size-sm);
  color: var(--color-text-secondary);
}

.feed-count {
  font-size: var(--font-size-xs);
  color: var(--color-primary);
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  background: rgba(255, 107, 53, 0.10);
}

.activity-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.loading-state,
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  padding: 140rpx 36rpx;
  text-align: center;
}

.loading-title,
.empty-title {
  font-size: 34rpx;
  color: var(--color-secondary);
  font-weight: 700;
}

.loading-desc,
.empty-text {
  font-size: var(--font-size-sm);
  line-height: 1.7;
  color: var(--color-text-secondary);
}

.loading-tip,
.no-more-tip {
  text-align: center;
  padding: 12rpx 0 8rpx;
  font-size: var(--font-size-sm);
  color: var(--color-text-secondary);
}

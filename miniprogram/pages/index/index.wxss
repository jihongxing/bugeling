/* pages/index/index.wxss */
.index-page {
  padding-top: 20rpx;
  padding-bottom: 40rpx;
}

.hero-card {
  position: relative;
  overflow: hidden;
  background: var(--surface-hero);
  border: 1rpx solid var(--color-overlay-soft);
  border-radius: 34rpx;
  padding: 34rpx;
  margin-bottom: 22rpx;
  box-shadow: 0 20rpx 48rpx var(--color-shadow);
  animation: cardRiseIn var(--motion-slow) var(--ease-standard);
}

.hero-glow {
  position: absolute;
  border-radius: 50%;
  pointer-events: none;
}

.hero-glow-left {
  width: 280rpx;
  height: 280rpx;
  top: -110rpx;
  left: -80rpx;
  background: radial-gradient(circle, var(--color-overlay-soft) 0%, transparent 72%);
}

.hero-glow-right {
  width: 320rpx;
  height: 320rpx;
  right: -120rpx;
  bottom: -150rpx;
  background: radial-gradient(circle, var(--color-overlay-cool) 0%, transparent 75%);
}

.hero-copy {
  position: relative;
  z-index: 2;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  margin-bottom: 28rpx;
  animation: fadeInSoft var(--motion-slow) var(--ease-standard);
}

.hero-kicker {
  align-self: flex-start;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  background: var(--accent-warm-bg);
  font-size: 21rpx;
  color: var(--text-hero-kicker);
  letter-spacing: 2rpx;
  font-weight: 700;
}

.hero-title {
  font-size: 50rpx;
  line-height: 1.22;
  color: var(--color-secondary);
  font-weight: 700;
  letter-spacing: 1rpx;
}

.hero-subtitle {
  font-size: var(--font-size-sm);
  line-height: 1.6;
  color: var(--color-text-secondary);
}

.hero-toolbar {
  position: relative;
  z-index: 2;
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 24rpx;
  animation: fadeInSoft var(--motion-normal) var(--ease-standard);
}

.location-chip {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 14rpx 18rpx;
  border-radius: 999rpx;
  background: var(--surface-chip);
  border: 1rpx solid var(--color-overlay-soft);
}

.location-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: var(--color-primary);
  flex-shrink: 0;
}

.location-name {
  min-width: 0;
  font-size: var(--font-size-sm);
  color: var(--color-secondary);
  font-weight: 500;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.refresh-btn {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 14rpx 20rpx;
  border-radius: 999rpx;
  background: var(--color-overlay-soft);
  border: 1rpx solid var(--color-overlay-soft);
  transition: transform var(--motion-fast) var(--ease-standard), background-color var(--motion-fast) var(--ease-standard);
}

.refresh-btn:active {
  transform: translateY(1rpx);
}

.refresh-icon,
.refresh-text {
  font-size: var(--font-size-sm);
  color: var(--color-primary);
  font-weight: 600;
}

.feed-section {
  background: var(--color-card);
  border-radius: 26rpx;
  padding: 30rpx 28rpx;
  border: 1rpx solid var(--color-border-soft);
  box-shadow: 0 12rpx 28rpx rgba(25, 28, 40, 0.06);
  margin-bottom: 24rpx;
  animation: cardRiseIn var(--motion-slow) var(--ease-standard);
}

.section-mark {
  display: inline-block;
  font-size: 20rpx;
  letter-spacing: 1.5rpx;
  color: var(--color-accent-cool);
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  border: 1rpx solid var(--accent-cool-border-soft);
  background: var(--accent-cool-bg-soft);
}

.feed-head {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 20rpx;
}

.feed-head-copy {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.feed-title {
  font-size: 36rpx;
  color: var(--color-secondary);
  font-weight: 700;
}

.feed-desc {
  font-size: var(--font-size-sm);
  color: var(--color-text-secondary);
}

.feed-count {
  font-size: var(--font-size-xs);
  color: var(--text-accent-soft);
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  background: var(--accent-warm-bg);
}

.activity-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.feed-empty-card {
  border-radius: 24rpx;
  background: var(--color-bg-elevated);
  border: 1rpx solid var(--color-border-soft);
  padding: 28rpx 24rpx;
}

.feed-empty-title {
  display: block;
  font-size: 30rpx;
  font-weight: 700;
  color: var(--color-secondary);
  margin-bottom: 10rpx;
}

.feed-empty-desc {
  display: block;
  font-size: 24rpx;
  line-height: 1.6;
  color: var(--color-text-secondary);
}

.loading-state,
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  padding: 140rpx 36rpx;
  text-align: center;
}

.loading-title,
.empty-title {
  font-size: 34rpx;
  color: var(--color-secondary);
  font-weight: 700;
}

.loading-desc,
.empty-text {
  font-size: var(--font-size-sm);
  line-height: 1.7;
  color: var(--color-text-secondary);
}

.loading-tip,
.no-more-tip {
  text-align: center;
  padding: 12rpx 0 8rpx;
  font-size: var(--font-size-sm);
  color: var(--color-text-secondary);
}

@media (prefers-color-scheme: dark) {
  .hero-kicker {
    background: var(--accent-warm-bg-strong);
  }

  .hero-subtitle {
    color: #C1C7D8;
  }

  .refresh-btn {
    background: var(--accent-warm-bg-soft);
    border-color: var(--accent-warm-border-soft);
  }

  .feed-empty-card {
    border-color: var(--color-border-soft);
  }

  .feed-section {
    box-shadow: 0 12rpx 28rpx rgba(0, 0, 0, 0.28);
  }

  .feed-count {
    background: var(--accent-warm-bg);
  }

  .feed-empty-card {
    background: var(--surface-card-strong);
    border-color: var(--color-border-soft);
  }
}

.report-page {
  padding-bottom: 56rpx;
}

.hero-card,
.card,
.cta-card {
  background: var(--surface-card-base);
  border-radius: 28rpx;
  box-shadow: var(--shadow-soft);
}

.hero-card {
  padding: 28rpx;
  margin-bottom: 24rpx;
  background: linear-gradient(180deg, var(--surface-card-warm) 0%, var(--surface-card-base) 72%);
}

.hero-head,
.section-head,
.info-item {
  display: flex;
  justify-content: space-between;
  gap: 16rpx;
}

.hero-head {
  align-items: center;
  margin-bottom: 16rpx;
}

.hero-kicker,
.hero-sync,
.hero-badge,
.tag-item {
  display: inline-flex;
  align-items: center;
  justify-content: center;
}

.hero-kicker {
  font-size: 24rpx;
  color: var(--text-warm-strong);
  background: var(--surface-card-base);
  border-radius: 999rpx;
  padding: 8rpx 18rpx;
  font-weight: 600;
}

.hero-sync {
  font-size: 22rpx;
  color: var(--text-status-warning);
  background: var(--surface-overlay-light);
  border-radius: 999rpx;
  padding: 8rpx 16rpx;
}

.hero-title {
  display: block;
  font-size: 40rpx;
  line-height: 1.35;
  color: var(--text-title-strong);
  font-weight: 700;
}

.hero-badges,
.tag-list {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.hero-badges {
  margin-top: 20rpx;
}

.hero-badge,
.tag-item {
  font-size: 24rpx;
  color: var(--text-body-strong);
  background: var(--surface-card-neutral-soft);
  border-radius: 999rpx;
  padding: 10rpx 18rpx;
}

.hero-badge.subtle {
  color: var(--text-body-muted);
  background: var(--surface-overlay-strong);
}

.hero-quick-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12rpx;
  margin-top: 20rpx;
}

.hero-quick-item {
  background: var(--surface-overlay-strong);
  border-radius: 20rpx;
  padding: 18rpx;
}

.hero-quick-label {
  display: block;
  font-size: 22rpx;
  color: var(--text-body-muted);
}

.hero-quick-value {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  line-height: 1.5;
  color: var(--text-title-strong);
  font-weight: 600;
}

.summary-box {
  margin-top: 24rpx;
  padding: 22rpx 24rpx;
  border-radius: 24rpx;
  background: var(--surface-overlay-medium);
}

.summary-label {
  display: block;
  font-size: 24rpx;
  color: var(--text-warm-strong);
  font-weight: 700;
  margin-bottom: 10rpx;
}

.summary-text,
.cta-desc,
.empty-text {
  font-size: 26rpx;
  line-height: 1.7;
  color: var(--text-body-soft);
}

.metric-label,
.info-label {
  font-size: 24rpx;
  color: var(--text-body-muted);
}

.metric-value,
.info-value {
  display: block;
  margin-top: 8rpx;
  font-size: 28rpx;
  color: var(--text-title-strong);
  font-weight: 600;
  line-height: 1.5;
}

.metric-value.compact {
  font-size: 26rpx;
}

.card,
.cta-card {
  padding: 28rpx;
  margin-bottom: 24rpx;
}

.section-head {
  align-items: center;
  margin-bottom: 8rpx;
}

.section-title,
.cta-title {
  font-size: 30rpx;
  color: var(--text-title-strong);
  font-weight: 700;
}

.section-side {
  font-size: 24rpx;
  color: var(--text-body-muted);
  text-align: right;
}

.info-item {
  padding: 18rpx 0;
  border-bottom: 1rpx solid var(--border-soft-2);
  align-items: flex-start;
}

.info-item:last-child {
  border-bottom: none;
}

.info-value {
  flex: 1;
  text-align: right;
  margin-top: 0;
}

.compact-tags {
  margin-top: 20rpx;
}

.cta-card {
  background: linear-gradient(135deg, var(--surface-card-warm) 0%, var(--surface-card-base) 100%);
}

.cta-desc {
  display: block;
  margin-top: 12rpx;
}

.cta-btn {
  width: 100%;
  margin-top: 24rpx;
}

.loading-state {
  display: flex;
  justify-content: center;
  align-items: center;
  min-height: 50vh;
}

.loading-text {
  font-size: 28rpx;
  color: var(--text-body-muted);
}

@media (prefers-color-scheme: dark) {
  .hero-card,
  .card,
  .cta-card,
  .hero-quick-item,
  .summary-box,
  .hero-badge.subtle {
    background: var(--surface-card-base);
  }

  .hero-card,
  .cta-card {
    background: linear-gradient(180deg, var(--surface-card-warm) 0%, var(--surface-card-base) 72%);
  }
}

<view class="page report-page" wx:if="{{reportView}}">
  <view class="hero-card">
    <view class="hero-head">
      <text class="hero-kicker">这次后来怎么样了</text>
      <text class="hero-sync" wx:if="{{loading}}">同步中</text>
    </view>

    <text class="hero-title">{{reportView.title}}</text>

    <view class="hero-badges">
      <text class="hero-badge">{{reportView.templateText}}</text>
      <text class="hero-badge subtle">{{reportView.participantHintText}}</text>
      <text class="hero-badge subtle" wx:if="{{reportView.reportDateText}}">{{reportView.reportDateText}}</text>
    </view>

    <view class="summary-box">
      <text class="summary-label">简单说一句</text>
      <text class="summary-text">{{reportView.summaryText}}</text>
    </view>

    <view class="hero-quick-grid">
      <view class="hero-quick-item">
        <text class="hero-quick-label">人数</text>
        <text class="hero-quick-value">{{reportView.participantsText}}</text>
      </view>
      <view class="hero-quick-item">
        <text class="hero-quick-label">大概会花</text>
        <text class="hero-quick-value">{{reportView.budgetText}}</text>
      </view>
      <view class="hero-quick-item">
        <text class="hero-quick-label">加入要付</text>
        <text class="hero-quick-value">{{reportView.feeText}}</text>
      </view>
      <view class="hero-quick-item">
        <text class="hero-quick-label">碰头点</text>
        <text class="hero-quick-value">{{reportView.meetingPointText}}</text>
      </view>
    </view>
  </view>

  <view class="cta-card">
    <text class="cta-title">这个小局还可以再来一次</text>
    <text class="cta-desc">{{reportView.noteText}}</text>
    <button class="btn-primary cta-btn" bindtap="goCreateSame">再来一次</button>
    <button class="btn-secondary cta-btn" wx:if="{{showReviewAction}}" bindtap="goReview">补一句感受</button>
  </view>

  <view class="card">
    <view class="section-head">
      <text class="section-title">这次大概是这么回事</text>
      <text class="section-side">顺手就能再开一次</text>
    </view>

    <view class="info-item" wx:for="{{reportView.infoRows}}" wx:key="label">
      <text class="info-label">{{item.label}}</text>
      <text class="info-value">{{item.value}}</text>
    </view>

    <view class="tag-list compact-tags" wx:if="{{reportView.safetyTags.length}}">
      <text class="tag-item" wx:for="{{reportView.safetyTags}}" wx:key="index">{{item}}</text>
    </view>
  </view>
</view>

<view class="page loading-state" wx:if="{{!reportView}}">
  <text class="loading-text">正在整理这次的小局...</text>
</view>

.template-page {
  padding-bottom: 48rpx;
}

.hero-card,
.template-card {
  background: #FFFFFF;
  border-radius: 28rpx;
  box-shadow: 0 12rpx 32rpx rgba(15, 23, 42, 0.06);
}

.hero-card {
  padding: 32rpx 28rpx;
  margin-bottom: 24rpx;
  background: linear-gradient(135deg, #FFF7ED 0%, #FFFFFF 72%);
}

.hero-kicker {
  display: block;
  font-size: 24rpx;
  color: #C2410C;
  font-weight: 700;
  margin-bottom: 12rpx;
}

.hero-title {
  display: block;
  font-size: 40rpx;
  line-height: 1.35;
  color: #111827;
  font-weight: 700;
}

.hero-desc {
  display: block;
  margin-top: 14rpx;
  font-size: 26rpx;
  line-height: 1.7;
  color: #6B7280;
}

.template-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.template-card {
  padding: 28rpx;
  border: 2rpx solid transparent;
}

.template-card.active {
  border-color: #FDBA74;
  box-shadow: 0 18rpx 40rpx rgba(249, 115, 22, 0.12);
}

.template-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 16rpx;
}

.template-title {
  font-size: 32rpx;
  color: #111827;
  font-weight: 700;
}

.template-badge {
  flex-shrink: 0;
  font-size: 22rpx;
  color: #C2410C;
  background: #FFF4EE;
  border-radius: 999rpx;
  padding: 8rpx 16rpx;
}

.template-desc,
.template-summary {
  display: block;
  font-size: 26rpx;
  line-height: 1.7;
}

.template-desc {
  margin-top: 18rpx;
  color: #1F2937;
  font-weight: 600;
}

.template-summary {
  margin-top: 8rpx;
  color: #6B7280;
}

.template-footer {
  margin-top: 20rpx;
}

.template-action {
  font-size: 26rpx;
  color: #EA580C;
  font-weight: 700;
}

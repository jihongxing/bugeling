.template-page {
  padding-bottom: 48rpx;
}

.hero-card,
.path-card {
  border-radius: 30rpx;
  border: 1rpx solid var(--color-border-soft);
  box-shadow: var(--shadow-soft);
  animation: cardRiseIn var(--motion-slow) var(--ease-standard);
}

.hero-card {
  padding: 32rpx 28rpx;
  margin-bottom: 24rpx;
  background: linear-gradient(135deg, var(--surface-card-warm) 0%, var(--surface-card-base) 72%);
}

.hero-title {
  display: block;
  font-size: 42rpx;
  line-height: 1.3;
  color: var(--text-title-strong);
  font-weight: 700;
}

.hero-desc {
  display: block;
  margin-top: 12rpx;
  font-size: 26rpx;
  line-height: 1.65;
  color: var(--text-body-muted);
}

.path-card {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
  padding: 28rpx;
  background: var(--surface-card-base);
}

.path-card:active {
  transform: translateY(1rpx);
}

.path-card.primary {
  margin-bottom: 18rpx;
  background: linear-gradient(140deg, #FFF9F2 0%, #FFFFFF 100%);
  border-color: var(--accent-warm-border-soft);
  box-shadow: var(--shadow-warm);
}

.secondary-grid {
  display: flex;
  gap: 16rpx;
  margin-bottom: 18rpx;
}

.path-card.secondary {
  flex: 1;
  min-height: 248rpx;
}

.path-card.secondary.cool {
  background: linear-gradient(160deg, rgba(31, 92, 99, 0.06) 0%, var(--surface-card-base) 100%);
  border-color: var(--accent-cool-border-soft);
}

.path-card.light {
  align-items: center;
  background: var(--surface-card-soft);
}

.path-copy {
  flex: 1;
  min-width: 0;
}

.path-kicker {
  display: inline-block;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  background: var(--accent-warm-bg-soft);
  color: var(--text-warm-strong);
  font-size: 20rpx;
  font-weight: 700;
  margin-bottom: 16rpx;
}

.path-card.secondary.cool .path-kicker {
  background: var(--accent-cool-bg-soft);
  color: var(--color-accent-cool);
}

.path-title {
  display: block;
  font-size: 32rpx;
  line-height: 1.35;
  color: var(--text-title-strong);
  font-weight: 700;
}

.path-desc {
  display: block;
  margin-top: 10rpx;
  font-size: 24rpx;
  line-height: 1.65;
  color: var(--text-body-muted);
}

.path-arrow {
  flex-shrink: 0;
  align-self: center;
  font-size: 38rpx;
  line-height: 1;
  color: var(--text-accent-soft);
}

@media (prefers-color-scheme: dark) {
  .hero-card,
  .path-card {
    background: var(--surface-card-strong);
    border-color: var(--color-border-soft);
    box-shadow: var(--shadow-soft);
  }

  .hero-card {
    background: linear-gradient(135deg, #2A2432 0%, #202432 72%);
  }

  .hero-title,
  .path-title {
    color: var(--text-title-strong);
  }

  .hero-desc,
  .path-desc {
    color: var(--text-body-muted);
  }

  .path-card.primary {
    background: linear-gradient(140deg, #2B2630 0%, var(--surface-card-base) 100%);
    border-color: var(--accent-warm-border-soft);
  }

  .path-card.secondary {
    background: linear-gradient(160deg, rgba(37, 43, 58, 0.96) 0%, var(--surface-card-base) 100%);
  }

  .path-card.secondary.cool {
    background: linear-gradient(160deg, rgba(31, 92, 99, 0.12) 0%, var(--surface-card-base) 100%);
    border-color: var(--accent-cool-border-soft);
  }

  .path-card.light {
    background: rgba(37, 43, 58, 0.92);
  }

  .path-kicker {
    background: var(--accent-warm-bg);
    color: #FFD8C5;
  }

  .path-card.secondary.cool .path-kicker {
    background: var(--accent-cool-bg-soft);
    color: #BFEAEC;
  }

  .path-arrow {
    color: #FFB08D;
  }
}

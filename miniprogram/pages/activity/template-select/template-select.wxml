<view class="page template-page">
  <view class="hero-card">
    <text class="hero-kicker">今天想发个什么小局</text>
    <text class="hero-title">先挑一个你现在最愿意顺手发出去的</text>
    <text class="hero-desc">散步、坐坐、吃点便宜的，别太正式就行。</text>
  </view>

  <view class="template-list">
    <view
      wx:for="{{templateOptions}}"
      wx:key="type"
      class="template-card {{selectedType === item.type ? 'active' : ''}}"
      bindtap="chooseTemplate"
      data-type="{{item.type}}"
    >
      <view class="template-head">
        <text class="template-title">{{item.label}}</text>
        <text class="template-badge">{{selectedType === item.type ? '当前已选' : '推荐模板'}}</text>
      </view>
      <text class="template-desc">{{item.desc}}</text>
      <text class="template-summary">{{item.summary}}</text>
      <view class="template-footer">
        <text class="template-action">就发这个 ›</text>
      </view>
    </view>
  </view>
</view>

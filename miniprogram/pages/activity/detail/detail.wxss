.detail-page {
  padding-bottom: 56rpx;
}

.hero-card,
.card,
.note-box {
  background: #FFFFFF;
  border-radius: 28rpx;
  box-shadow: 0 12rpx 32rpx rgba(15, 23, 42, 0.06);
}

.hero-card {
  padding: 28rpx;
  margin-bottom: 24rpx;
}

.hero-head,
.section-head,
.info-item,
.rule-item {
  display: flex;
  justify-content: space-between;
  gap: 16rpx;
}

.hero-head {
  align-items: center;
  margin-bottom: 16rpx;
}

.hero-badge,
.hero-tag,
.tag-item,
.progress-chip-text {
  display: inline-flex;
  align-items: center;
  justify-content: center;
}

.hero-badge {
  font-size: 24rpx;
  color: #C2410C;
  background: #FFF4EE;
  border-radius: 999rpx;
  padding: 8rpx 18rpx;
  font-weight: 600;
}

.hero-status-text {
  font-size: 24rpx;
  border-radius: 999rpx;
  padding: 8rpx 18rpx;
  font-weight: 600;
}

.hero-title {
  display: block;
  font-size: 40rpx;
  line-height: 1.35;
  color: #111827;
  font-weight: 700;
  margin-bottom: 12rpx;
}

.hero-summary {
  font-size: 26rpx;
  line-height: 1.7;
  color: #6B7280;
}

.hero-badges,
.tag-list {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 20rpx;
}

.hero-quick-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 12rpx;
  margin-top: 24rpx;
}

.hero-quick-item {
  background: #F8FAFC;
  border-radius: 20rpx;
  padding: 18rpx;
}

.hero-quick-label {
  display: block;
  font-size: 22rpx;
  color: #6B7280;
}

.hero-quick-value {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  line-height: 1.5;
  color: #111827;
  font-weight: 600;
}

.hero-tag,
.tag-item {
  font-size: 24rpx;
  color: #374151;
  background: #F3F4F6;
  border-radius: 999rpx;
  padding: 10rpx 18rpx;
}

.metric-label,
.info-label,
.credit-label {
  font-size: 24rpx;
  color: #6B7280;
}

.metric-value,
.info-value,
.credit-value {
  display: block;
  margin-top: 8rpx;
  font-size: 28rpx;
  color: #111827;
  font-weight: 600;
}

.card {
  padding: 28rpx;
  margin-bottom: 24rpx;
}

.section-title {
  font-size: 30rpx;
  color: #111827;
  font-weight: 700;
}

.subsection-title {
  display: block;
  font-size: 28rpx;
  color: #111827;
  font-weight: 700;
}

.section-side {
  font-size: 24rpx;
  color: #6B7280;
  text-align: right;
}

.progress-card .progress-chip {
  margin-top: 18rpx;
  display: inline-flex;
}

.progress-chip-text {
  font-size: 24rpx;
  border-radius: 999rpx;
  padding: 10rpx 18rpx;
}

.progress-ready .progress-chip-text,
.progress-fill.progress-ready {
  background: #DCFCE7;
  color: #15803D;
}

.progress-almost .progress-chip-text,
.progress-fill.progress-almost {
  background: #FEF3C7;
  color: #B45309;
}

.progress-forming .progress-chip-text,
.progress-fill.progress-forming {
  background: #E0F2FE;
  color: #0369A1;
}

.progress-full .progress-chip-text,
.progress-fill.progress-full {
  background: #E5E7EB;
  color: #4B5563;
}

.progress-track {
  height: 18rpx;
  border-radius: 999rpx;
  background: #F3F4F6;
  overflow: hidden;
  margin-top: 20rpx;
}

.progress-fill {
  height: 100%;
  border-radius: 999rpx;
}

.progress-hint {
  display: block;
  margin-top: 16rpx;
  font-size: 24rpx;
  color: #6B7280;
}

.info-item {
  padding: 18rpx 0;
  border-bottom: 1rpx solid #F3F4F6;
  align-items: flex-start;
}

.info-item:last-child {
  border-bottom: none;
}

.info-value {
  flex: 1;
  text-align: right;
  margin-top: 0;
  line-height: 1.5;
}

.contract-box,
.note-box {
  margin-top: 24rpx;
  background: #FFF7ED;
  border-radius: 24rpx;
  padding: 22rpx 24rpx;
}

.contract-title {
  display: block;
  font-size: 26rpx;
  color: #C2410C;
  font-weight: 700;
  margin-bottom: 8rpx;
}

.contract-text,
.paragraph,
.rule-text,
.note-text {
  font-size: 26rpx;
  line-height: 1.7;
  color: #4B5563;
}

.pay-breakdown-card {
  margin-top: 20rpx;
  padding: 20rpx 22rpx;
  border-radius: 20rpx;
  background: #FFF9F2;
  border: 1rpx solid #F5DDC5;
}

.pay-breakdown-title {
  display: block;
  font-size: 25rpx;
  color: #9F3616;
  font-weight: 700;
  margin-bottom: 10rpx;
}

.pay-breakdown-row {
  display: flex;
  justify-content: space-between;
  gap: 14rpx;
  padding: 12rpx 0;
  border-bottom: 1rpx solid rgba(159, 54, 22, 0.1);
}

.pay-breakdown-row:last-of-type {
  border-bottom: none;
}

.pay-breakdown-main {
  flex: 1;
}

.pay-breakdown-label {
  display: block;
  font-size: 24rpx;
  color: #3F2C22;
  font-weight: 600;
}

.pay-breakdown-hint {
  display: block;
  margin-top: 4rpx;
  font-size: 22rpx;
  line-height: 1.5;
  color: #7C5A4A;
}

.pay-breakdown-value {
  font-size: 26rpx;
  color: #111827;
  font-weight: 700;
}

.pay-breakdown-total {
  margin-top: 14rpx;
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}

.pay-breakdown-total-label {
  font-size: 24rpx;
  color: #3F2C22;
  font-weight: 600;
}

.pay-breakdown-total-value {
  font-size: 30rpx;
  color: #9F3616;
  font-weight: 700;
}

.pay-breakdown-tip {
  display: block;
  margin-top: 10rpx;
  font-size: 22rpx;
  line-height: 1.6;
  color: #7C5A4A;
}

.paragraph + .paragraph {
  margin-top: 12rpx;
}

.more-info-toggle {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.more-info-text {
  font-size: 26rpx;
  color: #C2410C;
  font-weight: 600;
}

.more-info-arrow {
  font-size: 24rpx;
  color: #C2410C;
}

.card-section + .card-section {
  margin-top: 28rpx;
  padding-top: 28rpx;
  border-top: 1rpx solid #F3F4F6;
}

.rule-list {
  margin-top: 20rpx;
}

.rule-item {
  align-items: flex-start;
  margin-bottom: 12rpx;
}

.rule-dot {
  width: 24rpx;
  color: #FF6B35;
}

.credit-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 18rpx 16rpx;
  margin-top: 18rpx;
}

.credit-item {
  background: #F8FAFC;
  border-radius: 20rpx;
  padding: 18rpx;
}

.inline-note {
  margin-top: 28rpx;
}

.action-area {
  margin-top: 32rpx;
  padding-bottom: 48rpx;
}

.action-btn {
  width: 100%;
  margin-bottom: 16rpx;
}

.status-tip,
.countdown-tip {
  background: #F8FAFC;
  border-radius: 20rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 16rpx;
}

.status-tip-text,
.countdown-tip text {
  font-size: 26rpx;
  color: #4B5563;
}

.loading-state {
  display: flex;
  justify-content: center;
  align-items: center;
  min-height: 50vh;
}

.loading-text {
  font-size: 28rpx;
  color: #6B7280;
}

.detail-empty-state {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 58vh;
}

.empty-card {
  width: 100%;
  padding: 36rpx 30rpx;
}

.empty-title {
  display: block;
  font-size: 32rpx;
  color: #111827;
  font-weight: 700;
  text-align: center;
}

.empty-desc {
  display: block;
  margin-top: 14rpx;
  font-size: 26rpx;
  line-height: 1.6;
  color: #6B7280;
  text-align: center;
}

.empty-btn {
  width: 100%;
  margin-top: 18rpx;
}

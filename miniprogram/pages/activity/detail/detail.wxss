.detail-page {
  padding-bottom: 56rpx;
}

.hero-card,
.card,
.note-box {
  background: var(--surface-card-base);
  border-radius: 28rpx;
  box-shadow: var(--shadow-soft);
}

.hero-card {
  padding: 28rpx;
  margin-bottom: 24rpx;
}

.hero-head,
.section-head,
.info-item,
.rule-item {
  display: flex;
  justify-content: space-between;
  gap: 16rpx;
}

.hero-head {
  align-items: center;
  margin-bottom: 16rpx;
}

.hero-badge,
.hero-tag,
.tag-item,
.progress-chip-text {
  display: inline-flex;
  align-items: center;
  justify-content: center;
}

.hero-badge {
  font-size: 24rpx;
  color: var(--text-warm-strong);
  background: var(--surface-card-warm-soft);
  border-radius: 999rpx;
  padding: 8rpx 18rpx;
  font-weight: 600;
}

.hero-status-text {
  font-size: 24rpx;
  border-radius: 999rpx;
  padding: 8rpx 18rpx;
  font-weight: 600;
}

.hero-title {
  display: block;
  font-size: 40rpx;
  line-height: 1.35;
  color: var(--text-title-strong);
  font-weight: 700;
  margin-bottom: 12rpx;
}

.hero-summary {
  font-size: 26rpx;
  line-height: 1.7;
  color: var(--text-body-muted);
}

.hero-badges,
.tag-list {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 20rpx;
}

.hero-quick-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 12rpx;
  margin-top: 24rpx;
}

.hero-quick-item {
  background: var(--surface-card-muted);
  border-radius: 20rpx;
  padding: 18rpx;
}

.hero-quick-label {
  display: block;
  font-size: 22rpx;
  color: var(--text-body-muted);
}

.hero-quick-value {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  line-height: 1.5;
  color: var(--text-title-strong);
  font-weight: 600;
}

.hero-tag,
.tag-item {
  font-size: 24rpx;
  color: var(--text-body-strong);
  background: var(--surface-card-neutral-soft);
  border-radius: 999rpx;
  padding: 10rpx 18rpx;
}

.metric-label,
.info-label,
.credit-label {
  font-size: 24rpx;
  color: var(--text-body-muted);
}

.metric-value,
.info-value,
.credit-value {
  display: block;
  margin-top: 8rpx;
  font-size: 28rpx;
  color: var(--text-title-strong);
  font-weight: 600;
}

.card {
  padding: 28rpx;
  margin-bottom: 24rpx;
}

.section-title {
  font-size: 30rpx;
  color: var(--text-title-strong);
  font-weight: 700;
}

.subsection-title {
  display: block;
  font-size: 28rpx;
  color: var(--text-title-strong);
  font-weight: 700;
}

.section-side {
  font-size: 24rpx;
  color: var(--text-body-muted);
  text-align: right;
}

.progress-card .progress-chip {
  margin-top: 18rpx;
  display: inline-flex;
}

.progress-chip-text {
  font-size: 24rpx;
  border-radius: 999rpx;
  padding: 10rpx 18rpx;
}

.progress-ready .progress-chip-text,
.progress-fill.progress-ready {
  background: var(--surface-card-success-soft);
  color: var(--text-status-success);
}

.progress-almost .progress-chip-text,
.progress-fill.progress-almost {
  background: var(--surface-progress-almost);
  color: var(--text-status-warning);
}

.progress-forming .progress-chip-text,
.progress-fill.progress-forming {
  background: var(--surface-card-info-soft);
  color: var(--text-status-info);
}

.progress-full .progress-chip-text,
.progress-fill.progress-full {
  background: var(--surface-card-neutral-strong);
  color: var(--text-status-neutral);
}

.progress-track {
  height: 18rpx;
  border-radius: 999rpx;
  background: var(--border-soft-2);
  overflow: hidden;
  margin-top: 20rpx;
}

.progress-fill {
  height: 100%;
  border-radius: 999rpx;
}

.progress-hint {
  display: block;
  margin-top: 16rpx;
  font-size: 24rpx;
  color: var(--text-body-muted);
}

.info-item {
  padding: 18rpx 0;
  border-bottom: 1rpx solid var(--border-soft-2);
  align-items: flex-start;
}

.info-item:last-child {
  border-bottom: none;
}

.info-value {
  flex: 1;
  text-align: right;
  margin-top: 0;
  line-height: 1.5;
}

.contract-box,
.note-box {
  margin-top: 24rpx;
  background: var(--surface-card-warm);
  border-radius: 24rpx;
  padding: 22rpx 24rpx;
}

.contract-title {
  display: block;
  font-size: 26rpx;
  color: var(--text-warm-strong);
  font-weight: 700;
  margin-bottom: 8rpx;
}

.contract-text,
.paragraph,
.rule-text,
.note-text {
  font-size: 26rpx;
  line-height: 1.7;
  color: var(--text-body-soft);
}

.pay-breakdown-card {
  margin-top: 20rpx;
  padding: 20rpx 22rpx;
  border-radius: 20rpx;
  background: var(--surface-card-warm-faint);
  border: 1rpx solid var(--border-warm-soft);
}

.pay-breakdown-title {
  display: block;
  font-size: 25rpx;
  color: var(--text-warm-soft);
  font-weight: 700;
  margin-bottom: 10rpx;
}

.pay-breakdown-row {
  display: flex;
  justify-content: space-between;
  gap: 14rpx;
  padding: 12rpx 0;
  border-bottom: 1rpx solid var(--border-warm-ink);
}

.pay-breakdown-row:last-of-type {
  border-bottom: none;
}

.pay-breakdown-main {
  flex: 1;
}

.pay-breakdown-label {
  display: block;
  font-size: 24rpx;
  color: var(--text-brown-strong);
  font-weight: 600;
}

.pay-breakdown-hint {
  display: block;
  margin-top: 4rpx;
  font-size: 22rpx;
  line-height: 1.5;
  color: var(--text-warm-muted);
}

.pay-breakdown-value {
  font-size: 26rpx;
  color: var(--text-title-strong);
  font-weight: 700;
}

.pay-breakdown-total {
  margin-top: 14rpx;
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}

.pay-breakdown-total-label {
  font-size: 24rpx;
  color: var(--text-brown-strong);
  font-weight: 600;
}

.pay-breakdown-total-value {
  font-size: 30rpx;
  color: var(--text-warm-soft);
  font-weight: 700;
}

.pay-breakdown-tip {
  display: block;
  margin-top: 10rpx;
  font-size: 22rpx;
  line-height: 1.6;
  color: var(--text-warm-muted);
}

.paragraph + .paragraph {
  margin-top: 12rpx;
}

.more-info-toggle {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.more-info-text {
  font-size: 26rpx;
  color: var(--text-warm-strong);
  font-weight: 600;
}

.more-info-arrow {
  font-size: 24rpx;
  color: var(--text-warm-strong);
}

.card-section + .card-section {
  margin-top: 28rpx;
  padding-top: 28rpx;
  border-top: 1rpx solid var(--border-soft-2);
}

.rule-list {
  margin-top: 20rpx;
}

.rule-item {
  align-items: flex-start;
  margin-bottom: 12rpx;
}

.rule-dot {
  width: 24rpx;
  color: var(--color-primary);
}

.credit-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 18rpx 16rpx;
  margin-top: 18rpx;
}

.credit-item {
  background: var(--surface-card-muted);
  border-radius: 20rpx;
  padding: 18rpx;
}

.inline-note {
  margin-top: 28rpx;
}

.action-area {
  margin-top: 32rpx;
  padding-bottom: 48rpx;
}

.action-btn {
  width: 100%;
  margin-bottom: 16rpx;
}

.status-tip,
.countdown-tip {
  background: var(--surface-card-muted);
  border-radius: 20rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 16rpx;
}

.status-tip-text,
.countdown-tip text {
  font-size: 26rpx;
  color: var(--text-body-soft);
}

.loading-state {
  display: flex;
  justify-content: center;
  align-items: center;
  min-height: 50vh;
}

.loading-text {
  font-size: 28rpx;
  color: var(--text-body-muted);
}

.detail-empty-state {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 58vh;
}

.empty-card {
  width: 100%;
  padding: 36rpx 30rpx;
}

.empty-title {
  display: block;
  font-size: 32rpx;
  color: var(--text-title-strong);
  font-weight: 700;
  text-align: center;
}

.empty-desc {
  display: block;
  margin-top: 14rpx;
  font-size: 26rpx;
  line-height: 1.6;
  color: var(--text-body-muted);
  text-align: center;
}

.empty-btn {
  width: 100%;
  margin-top: 18rpx;
}

@media (prefers-color-scheme: dark) {
  .hero-card,
  .card,
  .note-box,
  .credit-item,
  .status-tip,
  .countdown-tip,
  .hero-quick-item {
    background: var(--surface-card-base);
  }

  .contract-box,
  .note-box,
  .pay-breakdown-card {
    box-shadow: none;
  }
}

.detail-page {
  padding-bottom: 56rpx;
}

.hero-card,
.card,
.note-box {
  background: var(--surface-card-base);
  border-radius: 28rpx;
  box-shadow: var(--shadow-soft);
}

.hero-card {
  padding: 28rpx;
  margin-bottom: 24rpx;
}

.hero-head,
.section-head,
.info-item,
.rule-item,
.snapshot-line,
.compact-row {
  display: flex;
  justify-content: space-between;
  gap: 16rpx;
}

.hero-head {
  align-items: center;
  margin-bottom: 16rpx;
}

.hero-badge,
.hero-tag,
.tag-item,
.progress-chip-text {
  display: inline-flex;
  align-items: center;
  justify-content: center;
}

.hero-badge {
  font-size: 24rpx;
  color: var(--text-warm-strong);
  background: var(--surface-card-warm-soft);
  border-radius: 999rpx;
  padding: 8rpx 18rpx;
  font-weight: 600;
}

.hero-status-text {
  font-size: 24rpx;
  border-radius: 999rpx;
  padding: 8rpx 18rpx;
  font-weight: 600;
}

.hero-hook {
  display: block;
  font-size: 28rpx;
  line-height: 1.5;
  color: var(--text-warm-strong);
  font-weight: 700;
  margin-bottom: 10rpx;
}

.hero-title {
  display: block;
  font-size: 40rpx;
  line-height: 1.35;
  color: var(--text-title-strong);
  font-weight: 700;
  margin-bottom: 10rpx;
}

.hero-summary {
  font-size: 26rpx;
  line-height: 1.7;
  color: var(--text-body-muted);
}

.hero-badges,
.tag-list {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 18rpx;
}

.hero-tag,
.tag-item {
  font-size: 24rpx;
  color: var(--text-body-strong);
  background: var(--surface-card-neutral-soft);
  border-radius: 999rpx;
  padding: 10rpx 18rpx;
}

.hero-snapshot {
  margin-top: 24rpx;
  background: var(--surface-card-muted);
  border-radius: 24rpx;
  padding: 20rpx 22rpx;
}

.snapshot-line {
  align-items: baseline;
  padding: 12rpx 0;
}

.snapshot-line-link.is-link .snapshot-value {
  color: var(--color-primary);
}

.snapshot-line + .snapshot-line {
  border-top: 1rpx solid var(--border-soft-2);
}

.snapshot-label,
.info-label,
.credit-label,
.compact-label {
  font-size: 24rpx;
  color: var(--text-body-muted);
  flex-shrink: 0;
}

.snapshot-value,
.info-value,
.credit-value,
.compact-value {
  display: block;
  text-align: right;
  font-size: 26rpx;
  line-height: 1.5;
  color: var(--text-title-strong);
  font-weight: 600;
  flex: 1;
}

.card {
  padding: 28rpx;
  margin-bottom: 24rpx;
}

.section-title {
  font-size: 30rpx;
  color: var(--text-title-strong);
  font-weight: 700;
}

.subsection-title {
  display: block;
  font-size: 28rpx;
  color: var(--text-title-strong);
  font-weight: 700;
}

.section-side {
  font-size: 24rpx;
  color: var(--text-body-muted);
  text-align: right;
}

.progress-card .progress-chip {
  margin-top: 18rpx;
  display: inline-flex;
}

.progress-chip-text {
  font-size: 24rpx;
  border-radius: 999rpx;
  padding: 10rpx 18rpx;
}

.progress-ready .progress-chip-text,
.progress-fill.progress-ready {
  background: var(--surface-card-success-soft);
  color: var(--text-status-success);
}

.progress-almost .progress-chip-text,
.progress-fill.progress-almost {
  background: var(--surface-progress-almost);
  color: var(--text-status-warning);
}

.progress-forming .progress-chip-text,
.progress-fill.progress-forming {
  background: var(--surface-card-info-soft);
  color: var(--text-status-info);
}

.progress-full .progress-chip-text,
.progress-fill.progress-full {
  background: var(--surface-card-neutral-strong);
  color: var(--text-status-neutral);
}

.progress-track {
  height: 18rpx;
  border-radius: 999rpx;
  background: var(--border-soft-2);
  overflow: hidden;
  margin-top: 20rpx;
}

.progress-fill {
  height: 100%;
  border-radius: 999rpx;
}

.progress-hint {
  display: block;
  margin-top: 16rpx;
  font-size: 24rpx;
  color: var(--text-body-muted);
}

.compact-card {
  background: linear-gradient(180deg, rgba(255, 247, 238, 0.85) 0%, var(--surface-card-base) 100%);
}

.compact-row {
  align-items: center;
  padding: 16rpx 0;
}

.compact-row + .compact-row {
  border-top: 1rpx solid var(--border-soft-2);
}

.summary-card {
  padding-bottom: 20rpx;
}

.more-info-arrow {
  font-size: 24rpx;
  color: var(--text-warm-strong);
}

.card-section + .card-section {
  margin-top: 28rpx;
  padding-top: 28rpx;
  border-top: 1rpx solid var(--border-soft-2);
}

.rule-list {
  margin-top: 20rpx;
}

.rule-item {
  align-items: flex-start;
  margin-bottom: 12rpx;
}

.rule-dot {
  width: 24rpx;
  color: var(--color-primary);
}

.credit-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 18rpx 16rpx;
  margin-top: 18rpx;
}

.credit-item {
  background: var(--surface-card-muted);
  border-radius: 20rpx;
  padding: 18rpx;
}

.inline-note {
  margin-top: 28rpx;
}

.action-area {
  margin-top: 32rpx;
  padding-bottom: 48rpx;
}

.action-btn {
  width: 100%;
  margin-bottom: 16rpx;
}

.status-tip,
.countdown-tip {
  background: var(--surface-card-muted);
  border-radius: 20rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 16rpx;
}

.status-tip-text,
.countdown-tip text {
  font-size: 26rpx;
  color: var(--text-body-soft);
}

.loading-state {
  display: flex;
  justify-content: center;
  align-items: center;
  min-height: 50vh;
}

.loading-text {
  font-size: 28rpx;
  color: var(--text-body-muted);
}

.detail-empty-state {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 58vh;
}

.empty-card {
  width: 100%;
  padding: 36rpx 30rpx;
}

.empty-title {
  display: block;
  font-size: 32rpx;
  color: var(--text-title-strong);
  font-weight: 700;
  text-align: center;
}

.empty-desc {
  display: block;
  margin-top: 14rpx;
  font-size: 26rpx;
  line-height: 1.6;
  color: var(--text-body-muted);
  text-align: center;
}

.empty-btn {
  width: 100%;
  margin-top: 18rpx;
}

@media (prefers-color-scheme: dark) {
  .hero-card,
  .card,
  .note-box,
  .credit-item,
  .status-tip,
  .countdown-tip,
  .hero-snapshot {
    background: var(--surface-card-base);
  }

  .compact-card {
    background: var(--surface-card-base);
  }
}

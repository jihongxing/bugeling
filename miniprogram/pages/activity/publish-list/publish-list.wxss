.publish-page {
  padding-bottom: 48rpx;
}

.hero-card,
.section-card,
.list-card,
.grid-card {
  border-radius: 28rpx;
  border: 1rpx solid var(--color-border-soft);
  box-shadow: var(--shadow-soft);
  animation: cardRiseIn var(--motion-slow) var(--ease-standard);
}

.hero-card {
  padding: 30rpx 28rpx;
  margin-bottom: 22rpx;
  background: linear-gradient(135deg, var(--surface-card-warm) 0%, var(--surface-card-base) 72%);
}

.hero-kicker {
  display: inline-block;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  background: var(--accent-warm-bg-soft);
  color: var(--text-warm-strong);
  font-size: 20rpx;
  font-weight: 700;
  margin-bottom: 14rpx;
}

.hero-title {
  display: block;
  font-size: 40rpx;
  line-height: 1.3;
  color: var(--text-title-strong);
  font-weight: 700;
}

.hero-desc {
  display: block;
  margin-top: 12rpx;
  font-size: 25rpx;
  line-height: 1.65;
  color: var(--text-body-muted);
}

.section-card {
  margin-bottom: 20rpx;
  padding: 28rpx;
  background: var(--surface-card-base);
}

.section-head {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  margin-bottom: 18rpx;
}

.section-title {
  font-size: 32rpx;
  line-height: 1.35;
  color: var(--text-title-strong);
  font-weight: 700;
}

.section-desc {
  font-size: 24rpx;
  line-height: 1.6;
  color: var(--text-body-muted);
}

.grid-list {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.grid-card {
  width: 48.8%;
  box-sizing: border-box;
  padding: 22rpx;
  background: var(--surface-card-muted);
}

.grid-card.compact {
  min-height: 206rpx;
}

.grid-card.active {
  border-color: var(--accent-warm-border-strong);
  background: var(--surface-card-warm-faint);
}

.grid-title {
  display: block;
  font-size: 28rpx;
  line-height: 1.4;
  color: var(--text-title-strong);
  font-weight: 700;
}

.grid-desc {
  display: block;
  margin-top: 10rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: var(--text-body-muted);
}

.grid-badge {
  display: inline-block;
  margin-bottom: 12rpx;
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  background: var(--accent-warm-bg);
  color: var(--text-warm-strong);
  font-size: 20rpx;
  font-weight: 700;
}

.grid-action {
  display: inline-block;
  margin-top: 16rpx;
  font-size: 22rpx;
  color: var(--text-accent-soft);
  font-weight: 700;
}

.stack-list,
.template-groups {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.list-card {
  padding: 24rpx;
  background: var(--surface-card-soft);
}

.list-card.warm {
  background: linear-gradient(140deg, #FFF9F2 0%, #FFFFFF 100%);
  border-color: var(--accent-warm-border-soft);
}

.list-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 14rpx;
}

.list-badge {
  display: inline-block;
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  background: var(--accent-warm-bg);
  color: var(--text-warm-strong);
  font-size: 20rpx;
  font-weight: 700;
}

.list-badge.cool {
  background: var(--accent-cool-bg-soft);
  color: var(--color-accent-cool);
}

.list-action {
  font-size: 23rpx;
  color: var(--text-accent-soft);
  font-weight: 700;
}

.list-title {
  display: block;
  font-size: 30rpx;
  line-height: 1.4;
  color: var(--text-title-strong);
  font-weight: 700;
}

.list-desc {
  display: block;
  margin-top: 10rpx;
  font-size: 24rpx;
  line-height: 1.65;
  color: var(--text-body-muted);
}

.list-reason {
  display: block;
  margin-top: 14rpx;
  font-size: 23rpx;
  line-height: 1.6;
  color: var(--text-body-soft);
}

.loading-state {
  padding: 36rpx 12rpx 10rpx;
  text-align: center;
}

.loading-text {
  font-size: 24rpx;
  color: var(--text-body-muted);
}

@media (prefers-color-scheme: dark) {
  .hero-card {
    background: linear-gradient(135deg, var(--surface-card-warm) 0%, var(--surface-card-base) 72%);
  }

  .list-card.warm {
    background: linear-gradient(140deg, var(--surface-card-warm-faint) 0%, var(--surface-card-base) 100%);
  }
}

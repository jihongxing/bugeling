.create-page {
  padding-bottom: 48rpx;
}

.hero-card,
.section-card,
.preview-card {
  background: var(--color-card);
  border-radius: 26rpx;
  padding: 28rpx;
  border: 1rpx solid var(--color-border-soft);
  box-shadow: 0 12rpx 28rpx rgba(25, 28, 40, 0.06);
  margin-bottom: 24rpx;
  animation: cardRiseIn var(--motion-slow) var(--ease-standard);
}

.hero-card {
  position: relative;
  overflow: hidden;
  background: linear-gradient(135deg, #FFF7EE 0%, #FFFFFF 72%);
}

.hero-orb {
  position: absolute;
  border-radius: 50%;
  pointer-events: none;
}

.hero-orb-a {
  width: 240rpx;
  height: 240rpx;
  top: -100rpx;
  left: -70rpx;
  background: radial-gradient(circle, rgba(214, 84, 42, 0.14) 0%, rgba(214, 84, 42, 0) 72%);
}

.hero-orb-b {
  width: 280rpx;
  height: 280rpx;
  right: -100rpx;
  bottom: -130rpx;
  background: radial-gradient(circle, rgba(31, 92, 99, 0.11) 0%, rgba(31, 92, 99, 0) 74%);
}

.hero-kicker {
  position: relative;
  z-index: 2;
  display: inline-block;
  padding: 8rpx 16rpx;
  font-size: 21rpx;
  color: var(--color-primary-deep);
  border-radius: 999rpx;
  border: 1rpx solid var(--color-overlay-soft);
  background: rgba(214, 84, 42, 0.1);
  font-weight: 700;
  margin-bottom: 12rpx;
}

.hero-title {
  position: relative;
  z-index: 2;
  display: block;
  font-size: 44rpx;
  line-height: 1.3;
  color: var(--color-secondary);
  font-weight: 700;
  margin-bottom: 12rpx;
}

.hero-desc {
  position: relative;
  z-index: 2;
  font-size: 26rpx;
  line-height: 1.6;
  color: var(--color-text-secondary);
}

.prefill-banner {
  margin-top: 20rpx;
  padding: 18rpx 22rpx;
  border-radius: 22rpx;
  background: #FFF4EE;
  border: 1rpx solid rgba(255, 107, 53, 0.18);
}

.prefill-text {
  font-size: 24rpx;
  line-height: 1.6;
  color: #C2410C;
}

.hero-actions {
  margin-top: 20rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.hero-link-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 72rpx;
  padding: 0 28rpx;
  border-radius: 999rpx;
  background: #F8F2E8;
  color: #9F3616;
  font-size: 24rpx;
  font-weight: 600;
  border: 1rpx solid rgba(214, 84, 42, 0.26);
  margin: 0;
  transition: transform var(--motion-fast) var(--ease-standard), border-color var(--motion-fast) var(--ease-standard), background-color var(--motion-fast) var(--ease-standard);
}

.hero-link-btn:active {
  transform: translateY(1rpx);
}

.hero-link-btn.secondary {
  background: #FFFFFF;
  color: #365760;
}

.section-mark {
  display: inline-flex;
  margin-bottom: 10rpx;
  padding: 6rpx 14rpx;
  font-size: 20rpx;
  color: var(--color-accent-cool);
  border: 1rpx solid rgba(31, 92, 99, 0.25);
  border-radius: 999rpx;
  background: rgba(31, 92, 99, 0.08);
}

.section-title {
  display: block;
  font-size: 34rpx;
  color: var(--color-secondary);
  font-weight: 700;
  margin-bottom: 18rpx;
}

.section-tip {
  display: block;
  margin: -6rpx 0 22rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: var(--color-text-secondary);
}

.template-grid,
.option-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}

.template-card,
.option-card {
  width: 48.8%;
  border-radius: 22rpx;
  padding: 22rpx;
  background: #FBFAF8;
  border: 1rpx solid #EFE7DB;
  box-sizing: border-box;
  margin-bottom: 16rpx;
  transition: transform var(--motion-fast) var(--ease-standard), border-color var(--motion-fast) var(--ease-standard), box-shadow var(--motion-fast) var(--ease-standard);
}

.template-card:active,
.option-card:active {
  transform: translateY(1rpx);
}

.template-card.active,
.option-card.active,
.segment.active,
.deposit-option.selected {
  border-color: rgba(214, 84, 42, 0.35);
  background: #FFF5EB;
  color: #9F3616;
}

.template-label,
.option-title {
  display: block;
  font-size: 28rpx;
  color: var(--color-secondary);
  font-weight: 600;
  margin-bottom: 8rpx;
}

.template-desc,
.option-desc {
  font-size: 24rpx;
  line-height: 1.5;
  color: var(--color-text-secondary);
}

.form-group {
  margin-bottom: 28rpx;
}

.form-label {
  display: block;
  font-size: 26rpx;
  color: var(--color-ink-soft);
  font-weight: 600;
  margin-bottom: 12rpx;
}

.no-margin {
  margin-bottom: 0;
}

.form-input,
.form-textarea {
  width: 100%;
  background: #FBFAF8;
  border: 1rpx solid #EFE7DB;
  border-radius: 20rpx;
  font-size: 28rpx;
  line-height: 1.5;
  color: var(--color-secondary);
  box-sizing: border-box;
}

.form-input {
  height: 88rpx;
  line-height: 88rpx;
  padding: 0 24rpx;
}

.form-textarea {
  min-height: 180rpx;
  padding: 20rpx 24rpx;
}

.form-picker {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: #FBFAF8;
  border: 1rpx solid #EFE7DB;
  border-radius: 20rpx;
  padding: 22rpx 24rpx;
}

.picker-value {
  font-size: 28rpx;
  color: var(--color-secondary);
}

.picker-placeholder {
  font-size: 28rpx;
  color: var(--color-text-secondary);
}

.picker-arrow {
  font-size: 32rpx;
  color: #9CA3AF;
}

.location-help-row {
  display: flex;
  justify-content: flex-end;
  margin: -14rpx 4rpx 24rpx;
}

.location-help-link {
  font-size: 24rpx;
  color: #B9441D;
  text-decoration: underline;
  text-underline-offset: 4rpx;
}

.time-picker-row {
  display: flex;
  gap: 16rpx;
}

.time-picker-row picker,
.half {
  flex: 1;
}

.dual-stepper-row {
  display: flex;
  gap: 16rpx;
}

.stepper-card {
  flex: 1;
  background: #F9F5EF;
  border-radius: 24rpx;
  padding: 20rpx;
  border: 1rpx solid #EFE4D4;
}

.stepper {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.stepper-btn {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #FFFFFF;
  border-radius: 18rpx;
  font-size: 34rpx;
  color: #B9441D;
  font-weight: 700;
  border: 1rpx solid #F0E8DB;
  transition: transform var(--motion-fast) var(--ease-standard), background-color var(--motion-fast) var(--ease-standard);
}

.stepper-btn:active {
  transform: scale(0.97);
}

.stepper-value {
  flex: 1;
  text-align: center;
  font-size: 34rpx;
  color: var(--color-secondary);
  font-weight: 700;
}

.deposit-options {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}

.deposit-option {
  min-width: 130rpx;
  padding: 18rpx 24rpx;
  border-radius: 999rpx;
  background: #FBFAF8;
  border: 1rpx solid #EFE7DB;
  text-align: center;
  font-size: 26rpx;
  color: var(--color-ink-soft);
  transition: transform var(--motion-fast) var(--ease-standard), border-color var(--motion-fast) var(--ease-standard), background-color var(--motion-fast) var(--ease-standard);
}

.deposit-option:active {
  transform: translateY(1rpx);
}

.preview-card {
  margin-top: 4rpx;
  background: linear-gradient(135deg, #FFF9F2 0%, #FFFFFF 100%);
}

.preview-row {
  display: flex;
  justify-content: space-between;
  gap: 24rpx;
  padding: 12rpx 0;
}

.preview-label {
  font-size: 26rpx;
  color: var(--color-text-secondary);
}

.preview-value {
  font-size: 26rpx;
  color: var(--color-secondary);
  font-weight: 600;
  text-align: right;
}

.toggle-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 12rpx 0 20rpx;
}

.more-toggle {
  margin-top: 20rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 22rpx 24rpx;
  border-radius: 22rpx;
  background: #F8F2E8;
  border: 1rpx solid rgba(214, 84, 42, 0.2);
}

.more-toggle-text {
  font-size: 26rpx;
  color: #9F3616;
  font-weight: 600;
}

.more-toggle-arrow {
  font-size: 24rpx;
  color: #9F3616;
}

.optional-wrap {
  margin-top: 20rpx;
}

.optional-divider {
  height: 2rpx;
  background: var(--color-border-soft);
  margin-bottom: 24rpx;
}

.segmented {
  display: flex;
  gap: 12rpx;
}

.segment {
  flex: 1;
  padding: 18rpx 24rpx;
  border-radius: 999rpx;
  background: #FBFAF8;
  border: 1rpx solid #EFE7DB;
  text-align: center;
  font-size: 26rpx;
  color: var(--color-ink-soft);
  transition: transform var(--motion-fast) var(--ease-standard), border-color var(--motion-fast) var(--ease-standard), background-color var(--motion-fast) var(--ease-standard);
}

.segment:active {
  transform: translateY(1rpx);
}

.submit-area {
  margin-top: 40rpx;
}

.submit-btn {
  width: 100%;
}

@media (prefers-color-scheme: dark) {
  .hero-card,
  .section-card,
  .preview-card {
    background: var(--surface-card-strong);
    border-color: var(--color-border-soft);
    box-shadow: var(--shadow-soft);
  }

  .hero-card {
    background: linear-gradient(145deg, #2A2432 0%, #202432 66%, #252B3A 100%);
  }

  .hero-kicker {
    background: var(--accent-warm-bg);
    color: #FFD8C5;
    border-color: var(--accent-warm-border-soft);
  }

  .hero-title,
  .section-title,
  .template-label,
  .option-title,
  .picker-value,
  .preview-value,
  .stepper-value {
    color: var(--text-title-strong);
  }

  .hero-desc,
  .section-tip,
  .template-desc,
  .option-desc,
  .picker-placeholder,
  .preview-label,
  .form-label,
  .location-help-link {
    color: var(--text-body-muted);
  }

  .hero-link-btn {
    background: rgba(255, 255, 255, 0.06);
    color: #F3F6FA;
    border-color: rgba(255, 255, 255, 0.08);
  }

  .hero-link-btn.secondary {
    background: rgba(255, 255, 255, 0.03);
    color: #D9E1EE;
  }

  .template-card,
  .option-card,
  .stepper-card,
  .deposit-option,
  .segment,
  .more-toggle,
  .form-input,
  .form-textarea,
  .form-picker {
    background: var(--surface-card-muted);
    border-color: var(--color-border-soft);
  }

  .template-card.active,
  .option-card.active,
  .segment.active,
  .deposit-option.selected {
    background: var(--surface-card-warm-faint);
    border-color: var(--accent-warm-border-strong);
    color: #FFD8C5;
  }

  .form-input,
  .form-textarea,
  .form-picker {
    color: var(--text-title-strong);
  }

  .stepper-card {
    background: linear-gradient(145deg, #252B3A 0%, #202432 100%);
  }

  .stepper-btn {
    background: var(--surface-card-base);
    border-color: var(--color-border-soft);
    color: #FFD8C5;
  }

  .preview-card {
    background: linear-gradient(145deg, rgba(43, 38, 48, 0.96) 0%, var(--surface-card-base) 100%);
  }

  .more-toggle {
    background: rgba(240, 123, 78, 0.12);
    border-color: var(--accent-warm-border-soft);
  }

  .more-toggle-text,
  .more-toggle-arrow,
  .picker-arrow {
    color: #FFB08D;
  }

  .location-help-link {
    color: #FFB08D;
  }
}

.create-page {
  padding-bottom: 48rpx;
}

.hero-card,
.section-card,
.preview-card {
  background: #FFFFFF;
  border-radius: 28rpx;
  padding: 28rpx;
  box-shadow: 0 12rpx 32rpx rgba(15, 23, 42, 0.06);
  margin-bottom: 24rpx;
}

.hero-kicker {
  display: block;
  font-size: 24rpx;
  color: #FF6B35;
  font-weight: 600;
  margin-bottom: 12rpx;
}

.hero-title {
  display: block;
  font-size: 40rpx;
  line-height: 1.35;
  color: #111827;
  font-weight: 700;
  margin-bottom: 12rpx;
}

.hero-desc {
  font-size: 26rpx;
  line-height: 1.6;
  color: #6B7280;
}

.prefill-banner {
  margin-top: 20rpx;
  padding: 18rpx 22rpx;
  border-radius: 22rpx;
  background: #FFF4EE;
  border: 1rpx solid rgba(255, 107, 53, 0.18);
}

.prefill-text {
  font-size: 24rpx;
  line-height: 1.6;
  color: #C2410C;
}

.hero-actions {
  margin-top: 20rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.hero-link-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 72rpx;
  padding: 0 28rpx;
  border-radius: 999rpx;
  background: #FFF4EE;
  color: #C2410C;
  font-size: 24rpx;
  font-weight: 600;
  border: 2rpx solid #FED7AA;
  margin: 0;
}

.hero-link-btn.secondary {
  background: #FFFFFF;
  color: #9A3412;
}

.section-title {
  display: block;
  font-size: 30rpx;
  color: #111827;
  font-weight: 700;
  margin-bottom: 24rpx;
}

.section-tip {
  display: block;
  margin: -6rpx 0 22rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: #6B7280;
}

.template-grid,
.option-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.template-card,
.option-card {
  width: calc(50% - 8rpx);
  border-radius: 24rpx;
  padding: 22rpx;
  background: #F8FAFC;
  border: 2rpx solid transparent;
  box-sizing: border-box;
}

.template-card.active,
.option-card.active,
.segment.active,
.deposit-option.selected {
  border-color: #FF6B35;
  background: #FFF4EE;
  color: #C2410C;
}

.template-label,
.option-title {
  display: block;
  font-size: 28rpx;
  color: #111827;
  font-weight: 600;
  margin-bottom: 8rpx;
}

.template-desc,
.option-desc {
  font-size: 24rpx;
  line-height: 1.5;
  color: #6B7280;
}

.form-group {
  margin-bottom: 28rpx;
}

.form-label {
  display: block;
  font-size: 26rpx;
  color: #374151;
  font-weight: 600;
  margin-bottom: 12rpx;
}

.no-margin {
  margin-bottom: 0;
}

.form-input,
.form-textarea {
  width: 100%;
  background: #F8FAFC;
  border-radius: 20rpx;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  color: #111827;
  box-sizing: border-box;
}

.form-textarea {
  min-height: 160rpx;
}

.form-picker {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: #F8FAFC;
  border-radius: 20rpx;
  padding: 22rpx 24rpx;
}

.picker-value {
  font-size: 28rpx;
  color: #111827;
}

.picker-placeholder {
  font-size: 28rpx;
  color: #9CA3AF;
}

.picker-arrow {
  font-size: 32rpx;
  color: #9CA3AF;
}

.time-picker-row {
  display: flex;
  gap: 16rpx;
}

.time-picker-row picker,
.half {
  flex: 1;
}

.dual-stepper-row {
  display: flex;
  gap: 16rpx;
}

.stepper-card {
  flex: 1;
  background: #F8FAFC;
  border-radius: 24rpx;
  padding: 20rpx;
}

.stepper {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.stepper-btn {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #FFFFFF;
  border-radius: 18rpx;
  font-size: 34rpx;
  color: #FF6B35;
  font-weight: 700;
}

.stepper-value {
  flex: 1;
  text-align: center;
  font-size: 34rpx;
  color: #111827;
  font-weight: 700;
}

.deposit-options {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}

.deposit-option {
  min-width: 130rpx;
  padding: 18rpx 24rpx;
  border-radius: 999rpx;
  background: #F8FAFC;
  border: 2rpx solid transparent;
  text-align: center;
  font-size: 26rpx;
  color: #374151;
}

.preview-card {
  margin-top: 4rpx;
  background: linear-gradient(135deg, #FFF7ED 0%, #FFFFFF 100%);
}

.preview-row {
  display: flex;
  justify-content: space-between;
  gap: 24rpx;
  padding: 12rpx 0;
}

.preview-label {
  font-size: 26rpx;
  color: #6B7280;
}

.preview-value {
  font-size: 26rpx;
  color: #111827;
  font-weight: 600;
  text-align: right;
}

.toggle-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 12rpx 0 20rpx;
}

.more-toggle {
  margin-top: 20rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 22rpx 24rpx;
  border-radius: 22rpx;
  background: #FFF7ED;
  border: 2rpx solid rgba(255, 107, 53, 0.12);
}

.more-toggle-text {
  font-size: 26rpx;
  color: #C2410C;
  font-weight: 600;
}

.more-toggle-arrow {
  font-size: 24rpx;
  color: #C2410C;
}

.optional-wrap {
  margin-top: 20rpx;
}

.optional-divider {
  height: 2rpx;
  background: #F1F5F9;
  margin-bottom: 24rpx;
}

.segmented {
  display: flex;
  gap: 12rpx;
}

.segment {
  flex: 1;
  padding: 18rpx 24rpx;
  border-radius: 999rpx;
  background: #F8FAFC;
  border: 2rpx solid transparent;
  text-align: center;
  font-size: 26rpx;
  color: #374151;
}

.submit-area {
  margin-top: 40rpx;
}

.submit-btn {
  width: 100%;
}

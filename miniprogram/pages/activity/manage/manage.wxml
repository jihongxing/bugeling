<!-- pages/activity/manage/manage.wxml - 这局现在怎么样了 -->
<view class="page" wx:if="{{!loading && activity}}">
  <view class="manage-header card">
    <text class="manage-title">{{activity.title}}</text>
    <text class="manage-count">现在已经有 {{activity.currentParticipants}} / {{activity.maxParticipants}} 个人了</text>
    <text class="manage-note">你不用像管理员一样盯着它，先看看是不是快成局就行。</text>
    <view class="manage-actions">
      <button
        wx:if="{{showFlowSyncAction}}"
        class="btn-secondary"
        bindtap="syncFlowStatus"
        loading="{{flowSyncing}}"
      >
        {{flowSyncLabel}}
      </button>
      <button class="btn-secondary" bindtap="goCheckin">看看到场确认</button>
    </view>
  </view>

  <view class="participant-list">
    <view class="section-title">现在打算来的几个人</view>
    <view wx:if="{{participations.length === 0}}" class="empty-participants">
      <text class="empty-text">暂时还没人先报名，等有人占位后会显示在这里。</text>
    </view>
    <view
      wx:for="{{participations}}"
      wx:key="participationId"
      class="participant-item card"
    >
      <view class="participant-info">
        <text class="participant-name">{{item.nickName || '用户'}}</text>
        <view class="tag" style="background-color: {{item.statusConfig.bgColor}}; color: {{item.statusConfig.textColor}};">
          {{item.statusConfig.label}}
        </view>
      </view>
    </view>
  </view>
</view>
<view class="page loading-state" wx:if="{{loading}}">
  <text class="loading-text">加载中...</text>
</view>

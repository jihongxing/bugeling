.review-page {
  padding-bottom: 56rpx;
}

.hero-card,
.note-card,
.result-card {
  border-radius: 28rpx;
}

.hero-card {
  background: linear-gradient(135deg, #FFF7ED 0%, #FFFFFF 100%);
  border: 1rpx solid rgba(255, 107, 53, 0.12);
  box-shadow: 0 12rpx 32rpx rgba(15, 23, 42, 0.06);
  padding: 28rpx;
  margin-bottom: 24rpx;
}

.hero-head,
.section-head,
.text-footer {
  display: flex;
  justify-content: space-between;
  gap: 16rpx;
}

.hero-head {
  align-items: center;
  margin-bottom: 16rpx;
}

.hero-badge,
.hero-id,
.result-tag {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border-radius: 999rpx;
}

.hero-badge {
  font-size: 24rpx;
  color: #C2410C;
  background: #FFE7D6;
  padding: 8rpx 18rpx;
  font-weight: 600;
}

.hero-id {
  font-size: 22rpx;
  color: #6B7280;
  background: rgba(255, 255, 255, 0.8);
  padding: 8rpx 16rpx;
}

.hero-title {
  display: block;
  font-size: 40rpx;
  line-height: 1.35;
  color: #111827;
  font-weight: 700;
  margin-bottom: 12rpx;
}

.hero-target {
  display: block;
  font-size: 24rpx;
  color: #C2410C;
  margin-bottom: 10rpx;
}

.hero-desc,
.note-text,
.result-text {
  font-size: 26rpx;
  line-height: 1.7;
  color: #4B5563;
}

.section-head {
  align-items: baseline;
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 30rpx;
  color: #111827;
  font-weight: 700;
}

.section-side,
.field-hint,
.char-count {
  font-size: 24rpx;
  color: #6B7280;
}

.tag-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.tag-chip {
  min-width: 180rpx;
  padding: 18rpx 22rpx;
  border-radius: 22rpx;
  background: #F8FAFC;
  border: 2rpx solid transparent;
  box-sizing: border-box;
}

.tag-chip-active {
  box-shadow: 0 8rpx 20rpx rgba(15, 23, 42, 0.08);
}

.tag-chip-positive.tag-chip-active {
  background: #FFF7ED;
  border-color: rgba(255, 107, 53, 0.28);
}

.tag-chip-negative.tag-chip-active {
  background: #FEF2F2;
  border-color: rgba(239, 68, 68, 0.24);
}

.tag-chip-text {
  font-size: 26rpx;
  color: #374151;
  line-height: 1.4;
}

.field-hint {
  display: block;
  margin-top: 18rpx;
}

.review-textarea {
  width: 100%;
  min-height: 220rpx;
  background: #F8FAFC;
  border-radius: 24rpx;
  padding: 22rpx 24rpx;
  box-sizing: border-box;
  font-size: 28rpx;
  color: #111827;
  line-height: 1.6;
}

.text-footer {
  margin-top: 16rpx;
  align-items: center;
}

.note-card {
  background: #FFFFFF;
}

.submit-btn {
  width: 100%;
  margin-top: 8rpx;
}

.submit-btn[disabled] {
  background: #D1D5DB;
  color: #FFFFFF;
}

.result-card {
  margin-top: 24rpx;
}

.result-block + .result-block {
  margin-top: 24rpx;
}

.result-label {
  display: block;
  font-size: 24rpx;
  color: #6B7280;
  margin-bottom: 12rpx;
}

.compact-grid {
  gap: 12rpx;
}

.result-tag {
  font-size: 24rpx;
  padding: 10rpx 18rpx;
}

.result-tag-positive {
  color: #C2410C;
  background: #FFF4EE;
}

.result-tag-negative {
  color: #B91C1C;
  background: #FEE2E2;
}

.reset-btn {
  width: 100%;
  margin-top: 28rpx;
}

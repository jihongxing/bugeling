.review-page {
  padding-bottom: 56rpx;
}

.hero-card,
.note-card,
.result-card {
  border-radius: 28rpx;
}

.hero-card {
  background: linear-gradient(135deg, var(--surface-card-warm) 0%, var(--surface-card-base) 100%);
  border: 1rpx solid var(--accent-warm-bg);
  box-shadow: var(--shadow-soft);
  padding: 28rpx;
  margin-bottom: 24rpx;
}

.hero-head,
.section-head,
.text-footer {
  display: flex;
  justify-content: space-between;
  gap: 16rpx;
}

.hero-head {
  align-items: center;
  margin-bottom: 16rpx;
}

.hero-badge,
.result-tag {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border-radius: 999rpx;
}

.hero-badge {
  font-size: 24rpx;
  color: var(--text-warm-strong);
  background: var(--surface-card-warm-soft);
  padding: 8rpx 18rpx;
  font-weight: 600;
}

.hero-title {
  display: block;
  font-size: 40rpx;
  line-height: 1.35;
  color: var(--text-title-strong);
  font-weight: 700;
  margin-bottom: 12rpx;
}

.hero-target {
  display: block;
  font-size: 24rpx;
  color: var(--text-warm-strong);
  margin-bottom: 10rpx;
}

.hero-desc,
.note-text,
.result-text {
  font-size: 26rpx;
  line-height: 1.7;
  color: var(--text-body-soft);
}

.section-head {
  align-items: baseline;
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 30rpx;
  color: var(--text-title-strong);
  font-weight: 700;
}

.section-side,
.field-hint,
.char-count {
  font-size: 24rpx;
  color: var(--text-body-muted);
}

.mood-grid {
  display: flex;
  gap: 16rpx;
}

.mood-chip {
  flex: 1;
  padding: 22rpx 18rpx;
  border-radius: 24rpx;
  background: var(--surface-card-muted);
  border: 2rpx solid transparent;
  text-align: center;
}

.mood-chip-active {
  background: var(--surface-card-warm-soft);
  border-color: var(--accent-warm-border-strong);
  box-shadow: var(--shadow-pop);
}

.mood-chip-text {
  font-size: 28rpx;
  color: var(--text-body-strong);
  font-weight: 600;
}

.tag-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.tag-chip {
  min-width: 180rpx;
  padding: 18rpx 22rpx;
  border-radius: 22rpx;
  background: var(--surface-card-muted);
  border: 2rpx solid transparent;
  box-sizing: border-box;
}

.tag-chip-active {
  box-shadow: var(--shadow-pop);
}

.tag-chip-positive.tag-chip-active {
  background: var(--surface-card-warm);
  border-color: var(--accent-warm-border-strong);
}

.tag-chip-negative.tag-chip-active {
  background: var(--surface-card-danger-soft);
  border-color: rgba(239, 68, 68, 0.24);
}

.tag-chip-text {
  font-size: 26rpx;
  color: var(--text-body-strong);
  line-height: 1.4;
}

.field-hint {
  display: block;
  margin-top: 18rpx;
}

.review-textarea {
  width: 100%;
  min-height: 220rpx;
  background: var(--surface-card-muted);
  border-radius: 24rpx;
  padding: 22rpx 24rpx;
  box-sizing: border-box;
  font-size: 28rpx;
  color: var(--text-title-strong);
  line-height: 1.6;
}

.text-footer {
  margin-top: 16rpx;
  align-items: center;
}

.note-card {
  background: var(--surface-card-base);
}

.submit-btn {
  width: 100%;
  margin-top: 8rpx;
}

.submit-btn[disabled] {
  background: var(--surface-card-neutral-strong);
  color: #FFFFFF;
}

.result-card {
  margin-top: 24rpx;
}

.result-block + .result-block {
  margin-top: 24rpx;
}

.result-label {
  display: block;
  font-size: 24rpx;
  color: var(--text-body-muted);
  margin-bottom: 12rpx;
}

.compact-grid {
  gap: 12rpx;
}

.result-tag {
  font-size: 24rpx;
  padding: 10rpx 18rpx;
}

.result-tag-positive {
  color: var(--text-warm-strong);
  background: var(--surface-card-warm-soft);
}

.result-tag-negative {
  color: #B91C1C;
  background: var(--surface-card-danger-soft);
}

.reset-btn {
  width: 100%;
  margin-top: 28rpx;
}

@media (prefers-color-scheme: dark) {
  .note-card,
  .result-card {
    background: var(--surface-card-base);
  }
}

<view class="page review-page">
  <view class="hero-card">
    <view class="hero-head">
      <text class="hero-badge">{{isMockMode ? '原型预览' : '这次还顺利吗'}}</text>
    </view>
    <text class="hero-title">{{activityTitle}}</text>
    <text class="hero-target" wx:if="{{!isMockMode}}">想补一句给：{{reviewTargetText}}</text>
    <text class="hero-desc">{{introText}}</text>
  </view>

  <view class="card">
    <view class="section-head">
      <text class="section-title">这次整体感觉怎么样</text>
    </view>
    <view class="mood-grid">
      <view
        wx:for="{{moodOptions}}"
        wx:key="value"
        class="mood-chip {{selectedMood === item.value ? 'mood-chip-active' : ''}}"
        data-value="{{item.value}}"
        bindtap="onSelectMood"
      >
        <text class="mood-chip-text">{{item.label}}</text>
      </view>
    </view>
    <text class="field-hint">先点一个最接近的感觉就行。</text>
  </view>

  <view class="card" wx:if="{{selectedMood === 'issue'}}">
    <view class="section-head">
      <text class="section-title">如果有点问题，主要卡在哪</text>
    </view>
    <view class="tag-grid">
      <view
        wx:for="{{issueTagOptions}}"
        wx:key="label"
        class="tag-chip {{item.selected ? 'tag-chip-negative tag-chip-active' : ''}}"
        data-index="{{index}}"
        bindtap="onToggleIssueTag"
      >
        <text class="tag-chip-text">{{item.label}}</text>
      </view>
    </view>
    <text class="field-hint">不想选也没关系，直接补一句也可以。</text>
  </view>

  <view class="card">
    <view class="section-head">
      <text class="section-title">想补一句也行</text>
      <text class="section-side">选填</text>
    </view>
    <textarea
      class="review-textarea"
      maxlength="200"
      placeholder="如果你愿意，可以补一句真实感受。"
      value="{{comment}}"
      bindinput="onCommentInput"
    />
    <view class="text-footer">
      <text class="field-hint">说真实感受就行，不用太正式。</text>
      <text class="char-count">{{commentLength}}/200</text>
    </view>
  </view>

  <view class="card note-card">
    <view class="section-head">
      <text class="section-title">先看一眼</text>
    </view>
    <text class="note-text">{{submitRuleText}}</text>
  </view>

  <button
    class="btn-primary submit-btn"
    disabled="{{!canSubmit || submitting}}"
    bindtap="submitReview"
  >
    {{submitting ? '记一下...' : '说完了'}}
  </button>

  <view class="card result-card" wx:if="{{submitted && draftPreview}}">
    <view class="section-head">
      <text class="section-title">{{isMockMode ? '本地结果' : '刚刚记下的感受'}}</text>
      <text class="section-side">{{lastSubmittedAt}}</text>
    </view>

    <view class="result-block">
      <text class="result-label">整体感觉</text>
      <text class="result-text">{{draftPreview.moodLabel}}</text>
    </view>

    <view class="result-block" wx:if="{{draftPreview.issueTags && draftPreview.issueTags.length}}">
      <text class="result-label">主要卡点</text>
      <view class="tag-grid compact-grid">
        <text class="result-tag result-tag-negative" wx:for="{{draftPreview.issueTags}}" wx:key="*this">{{item}}</text>
      </view>
    </view>

    <view class="result-block">
      <text class="result-label">补的那一句</text>
      <text class="result-text">{{draftPreview.comment || '未填写'}}</text>
    </view>

    <button class="btn-secondary reset-btn" bindtap="resetForm">重新说一遍</button>
  </view>
</view>

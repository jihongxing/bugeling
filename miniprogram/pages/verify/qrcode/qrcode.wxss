/* pages/verify/qrcode/qrcode.wxss */
.page {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40rpx 32rpx;
  min-height: 100vh;
  background: var(--surface-page-muted);
}

.header {
  margin-bottom: 40rpx;
}

.title {
  font-size: 36rpx;
  font-weight: 600;
  color: var(--text-title-strong);
}

.qr-container {
  display: flex;
  justify-content: center;
  align-items: center;
  width: 480rpx;
  height: 480rpx;
  background: var(--surface-card-base);
  border-radius: 24rpx;
  box-shadow: var(--shadow-soft);
  margin-bottom: 32rpx;
}

.qr-wrapper {
  display: flex;
  justify-content: center;
  align-items: center;
}

.qr-canvas {
  width: 400rpx;
  height: 400rpx;
}

.loading,
.error {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.error {
  color: var(--text-status-danger);
}

.retry-btn {
  margin-top: 20rpx;
  font-size: 28rpx;
  color: var(--color-primary);
  background: transparent;
  border: 2rpx solid var(--color-primary);
  border-radius: 8rpx;
  padding: 8rpx 32rpx;
}

.countdown {
  margin-bottom: 32rpx;
}

.countdown-text {
  font-size: 32rpx;
  color: var(--color-primary);
  font-weight: 500;
}

.tips {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 48rpx;
}

.tip-text {
  font-size: 28rpx;
  color: var(--text-body-muted);
  line-height: 1.8;
}

.tip-text.warning {
  color: var(--text-status-danger);
  font-size: 24rpx;
}

.arrival-section {
  width: 100%;
  padding: 0 32rpx;
}

.arrival-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  font-size: 32rpx;
  color: #FFFFFF;
  background: var(--color-primary);
  border-radius: 16rpx;
  border: none;
}

.arrival-btn.arrived {
  background: var(--text-status-success);
}

.arrival-btn[disabled] {
  opacity: 0.7;
}

@media (prefers-color-scheme: dark) {
  .qr-container {
    box-shadow: var(--shadow-soft);
  }
}

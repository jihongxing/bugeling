.rules-page {
  padding-bottom: 48rpx;
}

.hero-card,
.section-card {
  background: var(--surface-card-base);
  border-radius: 28rpx;
  padding: 30rpx 28rpx;
  box-shadow: var(--shadow-soft);
  margin-bottom: 24rpx;
}

.hero-card {
  background: linear-gradient(135deg, var(--surface-card-warm) 0%, var(--surface-card-base) 72%);
}

.hero-kicker {
  display: block;
  font-size: 24rpx;
  color: var(--text-warm-strong);
  font-weight: 700;
  margin-bottom: 12rpx;
}

.hero-title {
  display: block;
  font-size: 40rpx;
  line-height: 1.35;
  color: var(--text-title-strong);
  font-weight: 700;
}

.hero-desc {
  display: block;
  margin-top: 14rpx;
  font-size: 26rpx;
  line-height: 1.7;
  color: var(--text-body-muted);
}

.section-title {
  display: block;
  font-size: 30rpx;
  color: var(--text-title-strong);
  font-weight: 700;
  margin-bottom: 20rpx;
}

.rule-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.rule-item {
  display: flex;
  gap: 16rpx;
  align-items: flex-start;
}

.rule-bullet {
  flex-shrink: 0;
  min-width: 52rpx;
  height: 52rpx;
  line-height: 52rpx;
  text-align: center;
  border-radius: 999rpx;
  background: var(--surface-card-warm-soft);
  color: var(--text-warm-strong);
  font-size: 22rpx;
  font-weight: 700;
}

.rule-text {
  font-size: 26rpx;
  line-height: 1.7;
  color: var(--text-body-strong);
}

@media (prefers-color-scheme: dark) {
  .hero-card {
    background: linear-gradient(135deg, var(--surface-card-warm) 0%, var(--surface-card-base) 72%);
  }
}

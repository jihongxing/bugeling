.rules-page {
  padding-bottom: 48rpx;
}

.hero-card,
.section-card {
  background: #FFFFFF;
  border-radius: 28rpx;
  padding: 30rpx 28rpx;
  box-shadow: 0 12rpx 32rpx rgba(15, 23, 42, 0.06);
  margin-bottom: 24rpx;
}

.hero-card {
  background: linear-gradient(135deg, #FFF7ED 0%, #FFFFFF 72%);
}

.hero-kicker {
  display: block;
  font-size: 24rpx;
  color: #C2410C;
  font-weight: 700;
  margin-bottom: 12rpx;
}

.hero-title {
  display: block;
  font-size: 40rpx;
  line-height: 1.35;
  color: #111827;
  font-weight: 700;
}

.hero-desc {
  display: block;
  margin-top: 14rpx;
  font-size: 26rpx;
  line-height: 1.7;
  color: #6B7280;
}

.section-title {
  display: block;
  font-size: 30rpx;
  color: #111827;
  font-weight: 700;
  margin-bottom: 20rpx;
}

.rule-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.rule-item {
  display: flex;
  gap: 16rpx;
  align-items: flex-start;
}

.rule-bullet {
  flex-shrink: 0;
  min-width: 52rpx;
  height: 52rpx;
  line-height: 52rpx;
  text-align: center;
  border-radius: 999rpx;
  background: #FFF4EE;
  color: #C2410C;
  font-size: 22rpx;
  font-weight: 700;
}

.rule-text {
  font-size: 26rpx;
  line-height: 1.7;
  color: #374151;
}

<view class="page rules-page">
  <view class="hero-card">
    <text class="hero-kicker">几个小提醒</text>
    <text class="hero-title">不用背规则，知道这些默认默契就差不多了</text>
    <text class="hero-desc">都是为了让大家更轻松地发局、加入和碰头。</text>
  </view>

  <view class="section-card" wx:for="{{sections}}" wx:key="title">
    <text class="section-title">{{item.title}}</text>
    <view class="rule-list">
      <view class="rule-item" wx:for="{{item.items}}" wx:key="index">
        <text class="rule-bullet">0{{index + 1}}</text>
        <text class="rule-text">{{item}}</text>
      </view>
    </view>
  </view>
</view>

<!-- pages/user/profile/profile.wxml - 个人中心 -->
<view class="page profile-page">
  <view class="hero-card" wx:if="{{creditInfo}}">
    <text class="hero-mark">MY BOARD</text>
    <text class="hero-kicker">我的信息分层</text>
    <text class="hero-title">{{summaryTitle}}</text>
    <text class="hero-desc">{{summaryText}}</text>
  </view>

  <view class="credit-card" wx:if="{{creditInfo}}">
    <view class="card-head">
      <text class="card-title">信用面板</text>
      <text class="card-tip">每次守约都会慢慢累积</text>
    </view>
    <view class="score-section">
      <text class="score-label">这阵子整体感觉</text>
      <text class="score-value">{{creditInfo.score}}</text>
      <credit-badge score="{{creditInfo.score}}" />
    </view>
    <view class="stats-section">
      <view class="stat-item">
        <text class="stat-value">{{creditInfo.totalVerified}}</text>
        <text class="stat-label">顺利碰成</text>
      </view>
      <view class="stat-item">
        <text class="stat-value">{{creditInfo.totalBreached}}</text>
        <text class="stat-label">临时没来</text>
      </view>
    </view>
  </view>

  <view class="section-card" wx:if="{{!loading}}">
    <view class="card-head" bindtap="toggleProfileSection" data-section="public">
      <view class="card-head-copy">
        <text class="card-title">公开展示</text>
        <text class="card-tip">别人看得到的基础信息</text>
      </view>
      <text class="card-head-arrow">{{expandedSection === 'public' ? '︿' : '﹀'}}</text>
    </view>
    <view class="section-summary">
      <view class="summary-chip-row">
        <text class="summary-chip" wx:for="{{profileView.publicSection.summaryChips}}" wx:key="index">{{item}}</text>
      </view>
      <text class="section-summary-sub">点击展开编辑</text>
    </view>
    <view wx:if="{{expandedSection === 'public'}}" class="section-body">
      <view class="field-item" bindtap="pickPublicGender">
        <text class="field-label">性别</text>
        <view class="field-value-row">
          <text class="field-value">{{profileView.publicSection.genderText}}</text>
          <text class="field-arrow">›</text>
        </view>
      </view>
      <view class="field-item" bindtap="pickPublicAgeBand">
        <text class="field-label">年龄</text>
        <view class="field-value-row">
          <text class="field-value">{{profileView.publicSection.ageBandText}}</text>
          <text class="field-arrow">›</text>
        </view>
      </view>
    </view>
  </view>

  <view class="section-card" wx:if="{{!loading}}">
    <view class="card-head" bindtap="toggleProfileSection" data-section="filter">
      <view class="card-head-copy">
        <text class="card-title">可筛选偏好</text>
        <text class="card-tip">系统先帮你过滤的条件</text>
      </view>
      <text class="card-head-arrow">{{expandedSection === 'filter' ? '︿' : '﹀'}}</text>
    </view>
    <view class="section-summary">
      <view class="summary-chip-row">
        <text class="summary-chip" wx:for="{{profileView.filterSection.summaryChips}}" wx:key="index">{{item}}</text>
      </view>
      <text class="section-summary-sub">点击展开编辑</text>
    </view>
    <view wx:if="{{expandedSection === 'filter'}}" class="section-body">
      <view class="field-item" bindtap="pickGenderRelation">
        <text class="field-label">更想看谁</text>
        <view class="field-value-row">
          <text class="field-value">{{profileView.filterSection.genderRelationText}}</text>
          <text class="field-arrow">›</text>
        </view>
      </view>
      <view class="field-item" bindtap="pickAgeRelation">
        <text class="field-label">年龄偏好</text>
        <view class="field-value-row">
          <text class="field-value">{{profileView.filterSection.ageRelationText}}</text>
          <text class="field-arrow">›</text>
        </view>
      </view>
      <view class="toggle-row">
        <text class="form-label no-margin">只看已实名</text>
        <switch checked="{{profile.filterPreferences.requireRealName}}" color="#FF6B35" bindchange="onRequireRealNameChange" />
      </view>
    </view>
  </view>

  <view class="section-card" wx:if="{{!loading}}">
    <view class="card-head" bindtap="toggleProfileSection" data-section="private">
      <view class="card-head-copy">
        <text class="card-title">仅本人可见</text>
        <text class="card-tip">只给自己留的补充信息</text>
      </view>
      <text class="card-head-arrow">{{expandedSection === 'private' ? '︿' : '﹀'}}</text>
    </view>
    <view class="section-summary">
      <view class="summary-chip-row">
        <text class="summary-chip" wx:for="{{profileView.privateSection.summaryChips}}" wx:key="index">{{item}}</text>
      </view>
      <text class="section-summary-sub">点击展开编辑</text>
    </view>
    <view wx:if="{{expandedSection === 'private'}}" class="section-body">
      <view class="form-group">
        <text class="form-label">生日</text>
        <input class="form-input" placeholder="例如 1996-08-12" value="{{profile.privateProfile.birthday}}" bindinput="onPrivateBirthdayInput" />
      </view>
      <view class="form-group">
        <text class="form-label">年龄补充</text>
        <input class="form-input" placeholder="例如 28" value="{{profile.privateProfile.exactAge}}" bindinput="onPrivateAgeInput" />
      </view>
      <view class="form-group">
        <text class="form-label">联系提醒</text>
        <input class="form-input" placeholder="例如：晚一点回消息" value="{{profile.privateProfile.contactHint}}" bindinput="onPrivateContactInput" />
      </view>
    </view>
  </view>

  <view class="submit-area" wx:if="{{!loading}}">
    <button class="btn-primary submit-btn" bindtap="saveProfile" disabled="{{savingProfile}}">
      {{savingProfile ? '保存中...' : '保存我的信息'}}
    </button>
  </view>

  <view class="loading" wx:if="{{loading}}">
    <text>加载中...</text>
  </view>

  <view class="nav-list" wx:if="{{!loading}}">
    <view class="list-head">
      <text class="list-title">常用入口</text>
      <text class="list-subtitle">复盘、再约、继续玩</text>
    </view>
    <view class="nav-item" bindtap="goToHistory" data-role="initiator">
      <view class="nav-copy">
        <text class="nav-title">我开过的局</text>
        <text class="nav-desc">看看自己发起过哪些局</text>
      </view>
      <text class="nav-arrow">›</text>
    </view>
    <view class="nav-item" bindtap="goToHistory" data-role="participant">
      <view class="nav-copy">
        <text class="nav-title">我去过的局</text>
        <text class="nav-desc">回看参加记录和节奏</text>
      </view>
      <text class="nav-arrow">›</text>
    </view>
    <view class="nav-item" bindtap="goToTemplateSelect">
      <view class="nav-copy">
        <text class="nav-title">再发一个小局</text>
        <text class="nav-desc">把当前状态继续串起来</text>
      </view>
      <text class="nav-arrow">›</text>
    </view>
  </view>
</view>

/* pages/user/profile/profile.wxss */
.page {
  padding: 32rpx;
  background: #f5f5f5;
  min-height: 100vh;
}

.hero-card {
  background: linear-gradient(135deg, #FFF7ED 0%, #FFFFFF 72%);
  border-radius: 24rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(255, 107, 53, 0.08);
}

.hero-kicker {
  display: block;
  font-size: 24rpx;
  color: #C2410C;
  font-weight: 600;
  margin-bottom: 12rpx;
}

.hero-title {
  display: block;
  font-size: 40rpx;
  line-height: 1.35;
  color: #111827;
  font-weight: 700;
  margin-bottom: 10rpx;
}

.hero-desc {
  font-size: 26rpx;
  line-height: 1.7;
  color: #6B7280;
}

.credit-card {
  background: #fff;
  border-radius: 24rpx;
  padding: 36rpx 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(15, 23, 42, 0.06);
}

.score-section {
  text-align: center;
  margin-bottom: 32rpx;
}

.score-label {
  display: block;
  font-size: 28rpx;
  color: #6B7280;
  margin-bottom: 16rpx;
}

.score-value {
  display: block;
  font-size: 80rpx;
  font-weight: 700;
  color: #111827;
  line-height: 1.2;
  margin-bottom: 16rpx;
}

.stats-section {
  display: flex;
  justify-content: center;
  gap: 80rpx;
  margin-bottom: 24rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid #F1F5F9;
}

.stat-item {
  text-align: center;
}

.stat-value {
  display: block;
  font-size: 36rpx;
  font-weight: 600;
  color: #111827;
}

.stat-label {
  display: block;
  font-size: 24rpx;
  color: #6B7280;
  margin-top: 8rpx;
}

.loading {
  text-align: center;
  padding: 40rpx;
  color: #999;
}

.nav-list {
  background: #fff;
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: 0 8rpx 24rpx rgba(15, 23, 42, 0.06);
}

.nav-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 32rpx;
  border-bottom: 1rpx solid #F1F5F9;
  font-size: 30rpx;
  color: #111827;
}

.nav-item:last-child {
  border-bottom: none;
}

.nav-arrow {
  color: #ccc;
  font-size: 28rpx;
}

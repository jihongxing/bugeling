/* pages/user/history/history.wxss */
.page {
  padding: 24rpx;
  background: var(--surface-page-muted);
  min-height: 100vh;
}

.hero-card {
  background: linear-gradient(135deg, var(--surface-card-warm) 0%, var(--surface-card-base) 72%);
  border-radius: 24rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
  box-shadow: var(--shadow-warm);
}

.hero-kicker {
  display: block;
  font-size: 24rpx;
  color: var(--text-warm-strong);
  font-weight: 600;
  margin-bottom: 12rpx;
}

.hero-title {
  display: block;
  font-size: 38rpx;
  line-height: 1.35;
  color: var(--text-title-strong);
  font-weight: 700;
  margin-bottom: 10rpx;
}

.hero-desc {
  font-size: 26rpx;
  line-height: 1.7;
  color: var(--text-body-muted);
}

.activity-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.activity-item {
  background: var(--surface-card-base);
  border-radius: 20rpx;
  padding: 28rpx 24rpx;
  box-shadow: var(--shadow-soft);
}

.activity-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.activity-title {
  font-size: 30rpx;
  font-weight: 500;
  color: var(--text-title-strong);
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.status-tag {
  font-size: 22rpx;
  padding: 4rpx 12rpx;
  border-radius: 999rpx;
  margin-left: 16rpx;
  flex-shrink: 0;
}

.status-pending {
  color: var(--text-status-warning);
  background: rgba(245, 158, 11, 0.1);
}

.status-active {
  color: var(--text-status-success);
  background: rgba(16, 185, 129, 0.1);
}

.status-completed {
  color: var(--text-body-muted);
  background: rgba(107, 114, 128, 0.1);
}

.status-cancelled {
  color: var(--text-status-danger);
  background: rgba(239, 68, 68, 0.1);
}

.activity-meta {
  margin-bottom: 8rpx;
}

.activity-time {
  font-size: 24rpx;
  color: var(--text-body-muted);
}

.participation-status {
  font-size: 24rpx;
  color: var(--text-body-muted);
  padding-top: 8rpx;
  border-top: 1rpx solid var(--border-soft-3);
  margin-top: 8rpx;
}

.activity-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 18rpx;
}

.mini-action {
  flex: 1;
  padding: 14rpx 0;
  font-size: 24rpx;
  line-height: 1.2;
}

.empty-state {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 120rpx 0;
}

.empty-text {
  font-size: 28rpx;
  color: var(--text-body-muted);
}

.loading {
  text-align: center;
  padding: 32rpx;
  color: var(--text-body-faint);
  font-size: 26rpx;
}

.load-more {
  text-align: center;
  padding: 24rpx;
}

.load-more-text {
  font-size: 24rpx;
  color: var(--text-body-faint);
}

@media (prefers-color-scheme: dark) {
  .hero-card,
  .activity-item {
    box-shadow: var(--shadow-soft);
  }
}

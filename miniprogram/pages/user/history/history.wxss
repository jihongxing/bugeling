/* pages/user/history/history.wxss */
.page {
  padding: 24rpx;
  background: #f5f5f5;
  min-height: 100vh;
}

.hero-card {
  background: linear-gradient(135deg, #FFF7ED 0%, #FFFFFF 72%);
  border-radius: 24rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 8rpx 24rpx rgba(255, 107, 53, 0.08);
}

.hero-kicker {
  display: block;
  font-size: 24rpx;
  color: #C2410C;
  font-weight: 600;
  margin-bottom: 12rpx;
}

.hero-title {
  display: block;
  font-size: 38rpx;
  line-height: 1.35;
  color: #111827;
  font-weight: 700;
  margin-bottom: 10rpx;
}

.hero-desc {
  font-size: 26rpx;
  line-height: 1.7;
  color: #6B7280;
}

.activity-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.activity-item {
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(15, 23, 42, 0.06);
}

.activity-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.activity-title {
  font-size: 30rpx;
  font-weight: 500;
  color: #111827;
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.status-tag {
  font-size: 22rpx;
  padding: 4rpx 12rpx;
  border-radius: 999rpx;
  margin-left: 16rpx;
  flex-shrink: 0;
}

.status-pending {
  color: #F59E0B;
  background: rgba(245, 158, 11, 0.1);
}

.status-active {
  color: #10B981;
  background: rgba(16, 185, 129, 0.1);
}

.status-completed {
  color: #6B7280;
  background: rgba(107, 114, 128, 0.1);
}

.status-cancelled {
  color: #EF4444;
  background: rgba(239, 68, 68, 0.1);
}

.activity-meta {
  margin-bottom: 8rpx;
}

.activity-time {
  font-size: 24rpx;
  color: #6B7280;
}

.participation-status {
  font-size: 24rpx;
  color: #6B7280;
  padding-top: 8rpx;
  border-top: 1rpx solid #F1F5F9;
  margin-top: 8rpx;
}

.activity-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 18rpx;
}

.mini-action {
  flex: 1;
  padding: 14rpx 0;
  font-size: 24rpx;
  line-height: 1.2;
}

.empty-state {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 120rpx 0;
}

.empty-text {
  font-size: 28rpx;
  color: #6B7280;
}

.loading {
  text-align: center;
  padding: 32rpx;
  color: #999;
  font-size: 26rpx;
}

.load-more {
  text-align: center;
  padding: 24rpx;
}

.load-more-text {
  font-size: 24rpx;
  color: #ccc;
}
